@model DeliveryDashboardViewModel
@{
    ViewData["Title"] = "Delivery Profile";
    ViewData["ActivePage"] = "Profile";
}
<main class="app-page shop-theme shop-portal-page"><div class="shop-portal-shell"><partial name="_Sidebar" model="Model" /><section class="shop-page-content">
<header class="shop-page-header"><div><span>PROFILE</span><h1>Delivery profile</h1><p>Identity, contact and vehicle information.</p></div></header>
@if (TempData["DeliverySuccess"] is string success) { <div class="order-message success">@success</div> }
@if (TempData["DeliveryError"] is string error) { <div class="order-message error">@error</div> }
<section class="panel"><form asp-action="UpdateProfile" method="post" enctype="multipart/form-data" class="delivery-form-grid">
<label>নাম *<input name="Name" value="@Model.DeliveryMan.Name" required /></label>
<label>মোবাইল<input value="@Model.DeliveryMan.Phone" disabled /></label>
<label>জন্মতারিখ<input name="DateOfBirth" type="date" value="@Model.DeliveryMan.DateOfBirth?.ToString("yyyy-MM-dd")" /></label>
<label>জরুরি যোগাযোগ<input name="EmergencyContact" value="@Model.DeliveryMan.EmergencyContact" /></label>
<label>জাতীয় পরিচয়পত্র নম্বর (optional)<input name="NidNumber" value="@Model.DeliveryMan.NidNumber" /></label>
<label>যানবাহনের ধরন<input name="VehicleType" value="@Model.DeliveryMan.VehicleType" /></label>
<label>যানবাহনের নম্বর<input name="VehicleNumber" value="@Model.DeliveryMan.VehicleNumber" /></label>
<label>ড্রাইভিং লাইসেন্স<input name="DrivingLicenseNumber" value="@Model.DeliveryMan.DrivingLicenseNumber" /></label>
<label class="wide">ঠিকানা *<input name="Address" value="@Model.DeliveryMan.Address" required /></label>
<label>New profile photo (optional)<input name="ProfilePhoto" type="file" accept="image/jpeg,image/png,image/webp" /></label>
<label>New জাতীয় পরিচয়পত্রের সামনের ছবি photo (optional)<input name="NidFrontPhoto" type="file" accept="image/jpeg,image/png,image/webp" /></label>
<label>New জাতীয় পরিচয়পত্রের পেছনের ছবি photo (optional)<input name="NidBackPhoto" type="file" accept="image/jpeg,image/png,image/webp" /></label>
<label>New license photo<input name="DrivingLicensePhoto" type="file" accept="image/jpeg,image/png,image/webp" /></label>
<div class="wide"><button class="btn-primary" type="submit">Save profile</button></div>
</form></section></section></div></main>
