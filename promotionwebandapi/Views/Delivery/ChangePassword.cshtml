@model DeliveryDashboardViewModel
@{
    ViewData["Title"] = "Change Password";
    ViewData["ActivePage"] = "ChangePassword";
}
<main class="app-page shop-theme shop-portal-page"><div class="shop-portal-shell"><partial name="_Sidebar" model="Model" /><section class="shop-page-content">
<header class="shop-page-header"><div><span>SECURITY</span><h1>পাসওয়ার্ড পরিবর্তন</h1></div></header>
@if (TempData["DeliverySuccess"] is string success) { <div class="order-message success">@success</div> }
@if (TempData["DeliveryError"] is string error) { <div class="order-message error">@error</div> }
<section class="panel"><form asp-action="ChangePassword" method="post" class="form-stack delivery-password-form">
<label>বর্তমান পাসওয়ার্ড<input name="OldPassword" type="password" required /></label>
<label>নতুন পাসওয়ার্ড<input name="NewPassword" type="password" minlength="4" required /></label>
<label>পাসওয়ার্ড নিশ্চিত করুন<input name="ConfirmPassword" type="password" minlength="4" required /></label>
<button class="btn-primary" type="submit">পাসওয়ার্ড পরিবর্তন</button>
</form></section></section></div></main>
