@model DeliveryDashboardViewModel
@{
    ViewData["Title"] = "দায়িত্ব পাওয়া অর্ডার";
    ViewData["ActivePage"] = "Orders";
    var activeOrders = Model.Assignments.Where(x => x.Status is not DeliveryStatus.Delivered and not DeliveryStatus.Rejected and not DeliveryStatus.Failed and not DeliveryStatus.Returned).ToList();
}
<main class="app-page shop-theme shop-portal-page">
    <div class="shop-portal-shell">
        <partial name="_Sidebar" model="Model" />
        <section class="shop-page-content">
            <header class="shop-page-header"><div><span>ASSIGNED ORDERS</span><h1>Delivery queue</h1><p>Accept and update only orders assigned to your account.</p></div></header>
            @if (TempData["DeliverySuccess"] is string success) { <div class="order-message success">@success</div> }
            @if (TempData["DeliveryError"] is string error) { <div class="order-message error">@error</div> }
            <section class="panel">
                <h2>Live location sharing</h2>
                <p class="delivery-location-note" data-location-status>Allow browser location permission to share your live delivery position.</p>
                <form asp-action="UpdateLocation"
                      method="post"
                      class="js-delivery-location-push"
                      data-assignment-id="@activeOrders.FirstOrDefault()?.AssignmentId"></form>
            </section>
            <div class="customer-orders-list">
                @foreach (var item in activeOrders)
                {
                    <article class="customer-order-card delivery-order-card">
                        <header><div><strong>Order #@item.OrderId</strong><small>@item.AssignedAt.ToString("dd MMM yyyy, hh:mm tt")</small></div><span class="status-chip pending">@item.Status</span></header>
                        <div class="customer-order-meta">
                            <span><b>Customer:</b> @item.CustomerName</span>
                            <a href="tel:@item.CustomerPhone"><b>Call:</b> @item.CustomerPhone</a>
                            <span><b>Collect:</b> ৳ @item.CollectionAmount.ToString("N2")</span>
                        </div>
                        @if (item.CustomerLatitude is not null && item.CustomerLongitude is not null)
                        {
                            <a class="btn-light" target="_blank" rel="noopener" href="https://www.google.com/maps?q=@item.CustomerLatitude,@item.CustomerLongitude">Open Google Maps</a>
                        }
                        <div class="customer-order-items">
                            @foreach (var detail in item.Details) { <span>@detail.ProductName x @detail.Quantity <b>৳ @detail.TotalPrice.ToString("N2")</b></span> }
                        </div>
                        <form asp-action="UpdateStatus" method="post" enctype="multipart/form-data" class="delivery-status-form">
                            <input type="hidden" name="assignmentId" value="@item.AssignmentId" />
                            @if (item.Status == DeliveryStatus.Assigned)
                            {
                                <button class="btn-primary" name="Status" value="@DeliveryStatus.Accepted" type="submit">Accept</button>
                                <button class="btn-light" name="Status" value="@DeliveryStatus.Rejected" type="submit">Reject</button>
                            }
                            else if (item.Status == DeliveryStatus.Accepted)
                            {
                                <button class="btn-primary" name="Status" value="@DeliveryStatus.PickedUp" type="submit">Picked up</button>
                                <button class="btn-light" name="Status" value="@DeliveryStatus.Failed" type="submit">ব্যর্থ</button>
                            }
                            else if (item.Status == DeliveryStatus.PickedUp)
                            {
                                <button class="btn-primary" name="Status" value="@DeliveryStatus.OutForDelivery" type="submit">Out for delivery</button>
                                <button class="btn-light" name="Status" value="@DeliveryStatus.Returned" type="submit">Return</button>
                            }
                            else if (item.Status == DeliveryStatus.OutForDelivery)
                            {
                                <input name="Otp" placeholder="Customer OTP (or upload proof)" maxlength="6" />
                                <input name="CashCollectedAmount" type="number" step="0.01" min="0" placeholder="Cash collected" />
                                <input name="DeliveryNote" placeholder="Delivery note" />
                                <input name="ProofPhoto" type="file" accept="image/jpeg,image/png,image/webp" />
                                <input name="CustomerSignature" type="file" accept="image/jpeg,image/png,image/webp" />
                                <input name="Latitude" type="hidden" class="delivery-latitude" />
                                <input name="Longitude" type="hidden" class="delivery-longitude" />
                                <button class="btn-primary" name="Status" value="@DeliveryStatus.Delivered" type="submit">Confirm delivered</button>
                                <button class="btn-light" name="Status" value="@DeliveryStatus.Failed" type="submit" formnovalidate>ব্যর্থ</button>
                            }
                        </form>
                    </article>
                }
                @if (activeOrders.Count == 0) { <p class="empty-state">No active delivery.</p> }
            </div>
        </section>
    </div>
</main>
@section Scripts {
    <script src="~/js/delivery-tracking.js" asp-append-version="true"></script>
    <script>
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(function (position) {
                document.querySelectorAll('.delivery-latitude').forEach(x => x.value = position.coords.latitude);
                document.querySelectorAll('.delivery-longitude').forEach(x => x.value = position.coords.longitude);
            });
        }
    </script>
}
