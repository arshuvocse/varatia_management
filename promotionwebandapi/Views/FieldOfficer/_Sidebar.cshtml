@model FieldOfficerDashboardViewModel
@{
    var active = ViewData["ActivePage"]?.ToString() ?? "Dashboard";
}
<aside class="sb-sidebar">
    <div class="sb-brand">
        <div class="sb-brand-logo">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="sb-cart-icon">
                <circle cx="9" cy="21" r="1"></circle>
                <circle cx="20" cy="21" r="1"></circle>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
            </svg>
            <div class="sb-brand-text">
                <span class="sb-brand-title">Smart<span class="sb-accent">Bazar</span></span>
            </div>
        </div>
    </div>

    <nav class="sb-nav" aria-label="ফিল্ড অফিসার মেনু">
        <a class="sb-nav-item @(active == "Dashboard" ? "active" : "")" href="/FieldForce">
            <span class="sb-nav-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </span>
            <span class="sb-nav-label">ড্যাশবোর্ড</span>
        </a>

        <a class="sb-nav-item @(active == "Shops" ? "active" : "")" href="/FieldForce/Shops">
            <span class="sb-nav-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/><path d="M2 9h20"/></svg>
            </span>
            <span class="sb-nav-label">দোকান সমূহ</span>
        </a>

        <a class="sb-nav-item @(active == "Products" ? "active" : "")" href="/FieldForce/Products">
            <span class="sb-nav-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
            </span>
            <span class="sb-nav-label">পণ্যের যাচাই</span>
        </a>

        <a class="sb-nav-item @(active == "Orders" ? "active" : "")" href="/FieldForce/Reports">
            <span class="sb-nav-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
            </span>
            <span class="sb-nav-label">অর্ডার মনিটর</span>
        </a>

        <a class="sb-nav-item @(active == "Reports" ? "active" : "")" href="/FieldForce/Reports">
            <span class="sb-nav-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
            </span>
            <span class="sb-nav-label">রিপোর্টস</span>
        </a>

        <a class="sb-nav-item @(active == "Messages" ? "active" : "")" href="/FieldForce/Messages">
            <span class="sb-nav-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </span>
            <span class="sb-nav-label">মেসেজ</span>
        </a>

        <a class="sb-nav-item @(active == "Notifications" ? "active" : "")" href="/FieldForce/Notifications">
            <span class="sb-nav-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
            </span>
            <span class="sb-nav-label">নোটিফিকেশন</span>
            <span class="sb-badge-count">১২</span>
        </a>

        <a class="sb-nav-item @(active == "Profile" ? "active" : "")" href="/FieldForce/Profile">
            <span class="sb-nav-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </span>
            <span class="sb-nav-label">প্রোফাইল</span>
        </a>
    </nav>

    <div class="sb-sidebar-footer">
        <form asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="sb-logout-btn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
                <span>লগআউট</span>
            </button>
        </form>
    </div>
</aside>
