@model FieldOfficerShopsViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "দাম সেটিং";
    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
    var pricingDataJson = JsonSerializer.Serialize(new
    {
        shops = Model.Shops.Select(shop => new
        {
            shop.Id,
            shop.ShopName,
            shop.ShopCode,
            shop.ShopType,
            shop.DivisionId,
            shop.DivisionName,
            shop.DistrictId,
            shop.DistrictName,
            shop.ThanaId,
            shop.ThanaName
        }),
        products = Model.Products.Select(product => new
        {
            product.Id,
            product.ProductCode,
            product.Name,
            product.Category,
            product.UnitPrice
        }),
        assignments = Model.Assignments
    });
}

@section Styles {
    <style>
        .price-manager { margin: 1.25rem 0; }
        .location-filter-grid { display: grid; grid-template-columns: repeat(4, minmax(160px, 1fr)); gap: .9rem; }
        .location-filter-grid label { display: grid; gap: .35rem; font-weight: 600; }
        .location-filter-grid input { width: 100%; }
        .price-manager-status { margin: 1rem 0; padding: .8rem 1rem; border-radius: 8px; background: #f1f5f9; color: #475569; }
        .price-manager-status.ready { background: #ecfdf5; color: #047857; }
        .shop-multi-panel { margin-top: 1rem; border: 1px solid #dbe5f1; border-radius: 10px; background: #fff; overflow: hidden; }
        .shop-multi-toolbar { display: flex; gap: .75rem; align-items: center; justify-content: space-between; padding: .8rem 1rem; background: #f8fafc; border-bottom: 1px solid #dbe5f1; }
        .shop-multi-toolbar button { border: 0; border-radius: 8px; padding: .45rem .75rem; cursor: pointer; }
        .shop-checkbox-list { display: grid; grid-template-columns: repeat(2, minmax(240px, 1fr)); gap: .65rem; max-height: 320px; overflow: auto; padding: 1rem; }
        .shop-checkbox-card { display: flex; gap: .6rem; align-items: flex-start; border: 1px solid #e2e8f0; border-radius: 10px; padding: .75rem; }
        .shop-checkbox-card input { margin-top: .2rem; }
        .shop-checkbox-card strong, .shop-checkbox-card small { display: block; }
        .shop-checkbox-card small { color: #64748b; }
        .bulk-product-list { display: grid; gap: .65rem; margin-top: 1rem; }
        .bulk-product-card { display: grid; grid-template-columns: minmax(240px, 1fr) 170px 170px; gap: .8rem; align-items: end; padding: .9rem; border: 1px solid #dbe5f1; border-radius: 10px; background: #fff; }
        .bulk-product-card > label { display: grid; gap: .3rem; }
        .product-toggle { display: flex !important; align-items: center; gap: .5rem !important; font-size: .9rem !important; }
        .product-toggle input { width: auto; }
        @@media (max-width: 900px) {
            .location-filter-grid, .shop-checkbox-list { grid-template-columns: repeat(2, 1fr); }
            .bulk-product-card { grid-template-columns: 1fr 1fr; }
            .bulk-product-card .product-toggle { grid-column: 1 / -1; }
        }
        @@media (max-width: 560px) {
            .location-filter-grid, .shop-checkbox-list, .bulk-product-card { grid-template-columns: 1fr; }
            .shop-multi-toolbar { align-items: stretch; flex-direction: column; }
            .bulk-product-card .product-toggle { grid-column: auto; }
        }
    </style>
}

<main class="app-page shop-theme shop-portal-page officer-portal-page">
    <div class="shop-portal-shell">
        <partial name="_Sidebar" model='new FieldOfficerDashboardViewModel { Shops = Model.Shops, OfficerName = Model.OfficerName }' view-data='new ViewDataDictionary(ViewData) { { "ActivePage", "Prices" } }' />
        <section class="shop-page-content">
            <header class="shop-page-header">
                <div>
                    <span>FIELD FORCE APP</span>
                    <h1>দাম সেটিং</h1>
                    <p>Division, district, thana বা shopkeeper search করে এক বা একাধিক দোকানদারের product purchase ও sales price সেট করুন।</p>
                </div>
            </header>

            @if (!string.IsNullOrWhiteSpace(successMessage))
            {
                <div class="alert-success">@successMessage</div>
            }
            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="validation-summary-errors">@errorMessage</div>
            }

            <section class="panel price-manager" id="shop-price-manager">
                <div class="panel-title-row">
                    <div>
                        <h2>Shop পণ্য price manager</h2>
                        <p>যেকোনো field-এ search করুন। একাধিক shopkeeper select করলে একই category-এর দোকান select করতে হবে।</p>
                    </div>
                </div>

                <div class="location-filter-grid">
                    <label>Division<input id="pricing-division" list="pricing-division-list" placeholder="Division search করুন" autocomplete="off" /></label>
                    <label>District<input id="pricing-district" list="pricing-district-list" placeholder="District search করুন" autocomplete="off" /></label>
                    <label>Thana<input id="pricing-thana" list="pricing-thana-list" placeholder="Thana search করুন" autocomplete="off" /></label>
                    <label>Shopkeeper<input id="pricing-shop-search" placeholder="Shopkeeper নাম/কোড search করুন" autocomplete="off" /></label>
                </div>
                <datalist id="pricing-division-list"></datalist>
                <datalist id="pricing-district-list"></datalist>
                <datalist id="pricing-thana-list"></datalist>

                <div class="price-manager-status" id="pricing-status">Search করুন অথবা নিচের list থেকে shopkeeper select করুন।</div>

                <div class="shop-multi-panel">
                    <div class="shop-multi-toolbar">
                        <strong id="shop-result-summary">0 shopkeeper</strong>
                        <div>
                            <button type="button" id="select-visible-shops">Visible select</button>
                            <button type="button" id="clear-selected-shops">Clear</button>
                        </div>
                    </div>
                    <div class="shop-checkbox-list" id="pricing-shop-list"></div>
                </div>

                <form action="/FieldForce/Shops/Prices" method="post" id="pricing-form" hidden>
                    @Html.AntiForgeryToken()
                    <div id="pricing-shop-ids"></div>
                    <div id="product-selection-toolbar" style="margin-top: 1rem; margin-bottom: -0.5rem; display: none;">
                        <label style="display: flex; gap: 0.5rem; align-items: center; font-weight: 600; cursor: pointer; user-select: none;">
                            <input type="checkbox" id="select-all-products"> Select all products
                        </label>
                    </div>
                    <div class="bulk-product-list" id="pricing-products"></div>
                    <button type="submit" class="btn-primary" style="margin-top:1rem">Selected shopkeeper price save</button>
                </form>
            </section>
        </section>
    </div>
</main>

@section Scripts {
    <script>
        (() => {
            const pricingData = @Html.Raw(pricingDataJson);
            const divisionInput = document.getElementById('pricing-division');
            const districtInput = document.getElementById('pricing-district');
            const thanaInput = document.getElementById('pricing-thana');
            const shopSearchInput = document.getElementById('pricing-shop-search');
            const shopList = document.getElementById('pricing-shop-list');
            const shopSummary = document.getElementById('shop-result-summary');
            const selectVisibleButton = document.getElementById('select-visible-shops');
            const clearSelectedButton = document.getElementById('clear-selected-shops');
            const pricingForm = document.getElementById('pricing-form');
            const shopIdsContainer = document.getElementById('pricing-shop-ids');
            const productContainer = document.getElementById('pricing-products');
            const selectAllProductsCheckbox = document.getElementById('select-all-products');
            const productSelectionToolbar = document.getElementById('product-selection-toolbar');
            const pricingStatus = document.getElementById('pricing-status');
            const selectedShopIds = new Set();

            const escapeHtml = value => String(value ?? '')
                .replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;').replaceAll("'", '&#039;');
            const normalize = value => String(value ?? '').trim().toLocaleLowerCase();
            const uniqueValues = values => [...new Set(values.filter(Boolean))].sort((left, right) => left.localeCompare(right));
            const fillDatalist = (id, values) => {
                document.getElementById(id).innerHTML = values
                    .map(value => `<option value="${escapeHtml(value)}"></option>`)
                    .join('');
            };
            const includesText = (value, search) => normalize(value).includes(normalize(search));

            fillDatalist('pricing-division-list', uniqueValues(pricingData.shops.map(shop => shop.DivisionName)));
            fillDatalist('pricing-district-list', uniqueValues(pricingData.shops.map(shop => shop.DistrictName)));
            fillDatalist('pricing-thana-list', uniqueValues(pricingData.shops.map(shop => shop.ThanaName)));

            const getFilteredShops = () => pricingData.shops.filter(shop => {
                const shopText = `${shop.ShopName} ${shop.ShopCode} ${shop.ShopType}`;
                return (!divisionInput.value || includesText(shop.DivisionName, divisionInput.value))
                    && (!districtInput.value || includesText(shop.DistrictName, districtInput.value))
                    && (!thanaInput.value || includesText(shop.ThanaName, thanaInput.value))
                    && (!shopSearchInput.value || includesText(shopText, shopSearchInput.value));
            });

            const renderShops = () => {
                const shops = getFilteredShops();
                shopSummary.textContent = `${shops.length} shopkeeper found · ${selectedShopIds.size} selected`;
                shopList.innerHTML = shops.map(shop => `
                    <label class="shop-checkbox-card">
                        <input type="checkbox" value="${shop.Id}" ${selectedShopIds.has(shop.Id) ? 'checked' : ''}>
                        <span>
                            <strong>${escapeHtml(shop.ShopName)} (${escapeHtml(shop.ShopCode)})</strong>
                            <small>${escapeHtml(shop.ShopType)} · ${escapeHtml(shop.DivisionName)} · ${escapeHtml(shop.DistrictName)} · ${escapeHtml(shop.ThanaName)}</small>
                        </span>
                    </label>
                `).join('') || '<p class="empty-state">এই search অনুযায়ী কোনো shopkeeper পাওয়া যায়নি।</p>';

                shopList.querySelectorAll('input[type="checkbox"]').forEach(checkbox => {
                    checkbox.addEventListener('change', () => {
                        const shopId = Number(checkbox.value);
                        if (checkbox.checked) selectedShopIds.add(shopId);
                        else selectedShopIds.delete(shopId);
                        renderProducts();
                        renderShops();
                    });
                });
                renderProducts();
            };

            const renderProducts = () => {
                const selectedShops = pricingData.shops.filter(shop => selectedShopIds.has(shop.Id));
                pricingForm.hidden = selectedShops.length === 0;
                shopIdsContainer.innerHTML = selectedShops
                    .map(shop => `<input type="hidden" name="ShopkeeperIds" value="${shop.Id}">`)
                    .join('');
                productContainer.innerHTML = '';

                if (selectedShops.length === 0) {
                    pricingStatus.textContent = 'কমপক্ষে একজন shopkeeper select করুন।';
                    pricingStatus.classList.remove('ready');
                    return;
                }

                const selectedTypes = [...new Set(selectedShops.map(shop => shop.ShopType))];
                if (selectedTypes.length > 1) {
                    pricingForm.hidden = true;
                    productSelectionToolbar.style.display = 'none';
                    pricingStatus.textContent = 'একসাথে price save করতে একই category-এর shopkeeper select করুন।';
                    pricingStatus.classList.remove('ready');
                    return;
                }

                const shopType = selectedTypes[0];
                const firstShop = selectedShops[0];
                const assignments = new Map(pricingData.assignments
                    .filter(item => item.ShopkeeperId === firstShop.Id)
                    .map(item => [item.CompanyProductId, item]));
                const products = pricingData.products.filter(product => product.Category === shopType);
                pricingStatus.textContent = `${selectedShops.length} shopkeeper selected · ${shopType} · ${products.length} products`;
                pricingStatus.classList.add('ready');
                
                let allChecked = true;
                productContainer.innerHTML = products.map((product, index) => {
                    const assignment = assignments.get(product.Id);
                    if (!assignment) allChecked = false;
                    const purchasePrice = assignment?.PurchasePrice ?? product.UnitPrice;
                    const salesPrice = assignment?.SalesPrice ?? product.UnitPrice;
                    return `<div class="bulk-product-card">
                        <label class="product-toggle">
                            <input type="checkbox" name="SelectedProductIds" value="${product.Id}" ${assignment ? 'checked' : ''}>
                            <span><strong>${escapeHtml(product.Name)}</strong><small>${escapeHtml(product.ProductCode)}</small></span>
                        </label>
                        <input type="hidden" name="ProductPrices[${index}].CompanyProductId" value="${product.Id}">
                        <label>Purchase price<input type="number" name="ProductPrices[${index}].PurchasePrice" min="0" step="0.01" value="${Number(purchasePrice).toFixed(2)}"></label>
                        <label>Sales price<input type="number" name="ProductPrices[${index}].SalesPrice" min="0.01" step="0.01" value="${Number(salesPrice).toFixed(2)}"></label>
                    </div>`;
                }).join('') || '<p class="empty-state">এই shop category-এর কোনো product নেই।</p>';
                
                if (products.length > 0) {
                    productSelectionToolbar.style.display = 'flex';
                    selectAllProductsCheckbox.checked = allChecked;
                } else {
                    productSelectionToolbar.style.display = 'none';
                }
            };

            [divisionInput, districtInput, thanaInput, shopSearchInput].forEach(input => {
                input.addEventListener('input', renderShops);
            });
            selectVisibleButton.addEventListener('click', () => {
                getFilteredShops().forEach(shop => selectedShopIds.add(shop.Id));
                renderShops();
            });
            clearSelectedButton.addEventListener('click', () => {
                selectedShopIds.clear();
                renderShops();
            });
            selectAllProductsCheckbox.addEventListener('change', (e) => {
                const isChecked = e.target.checked;
                pricingForm.querySelectorAll('input[name="SelectedProductIds"]').forEach(checkbox => {
                    checkbox.checked = isChecked;
                });
            });
            productContainer.addEventListener('change', (e) => {
                if (e.target.name === 'SelectedProductIds') {
                    const checkboxes = pricingForm.querySelectorAll('input[name="SelectedProductIds"]');
                    const checkedCheckboxes = pricingForm.querySelectorAll('input[name="SelectedProductIds"]:checked');
                    selectAllProductsCheckbox.checked = checkboxes.length > 0 && checkboxes.length === checkedCheckboxes.length;
                }
            });
            pricingForm.addEventListener('submit', event => {
                const selectedProducts = [...pricingForm.querySelectorAll('input[name="SelectedProductIds"]:checked')];
                if (selectedShopIds.size === 0 || selectedProducts.length === 0) {
                    event.preventDefault();
                    pricingStatus.textContent = 'Shopkeeper এবং কমপক্ষে একটি product select করুন।';
                    pricingStatus.classList.remove('ready');
                    return;
                }

                for (const checkbox of selectedProducts) {
                    const card = checkbox.closest('.bulk-product-card');
                    const purchase = Number(card.querySelector('input[name$=".PurchasePrice"]').value);
                    const sales = Number(card.querySelector('input[name$=".SalesPrice"]').value);
                    if (purchase < 0 || sales <= 0 || sales < purchase) {
                        event.preventDefault();
                        pricingStatus.textContent = 'Sales price অবশ্যই purchase price-এর সমান বা বেশি হতে হবে।';
                        pricingStatus.classList.remove('ready');
                        card.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        return;
                    }
                }
            });

            renderShops();
        })();
    </script>
}
