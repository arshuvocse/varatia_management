@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    // Sidebar Mobile Toggle
    const sidebarToggle = document.getElementById('sidebar-toggle-btn');
    const sidebar = document.querySelector('.sb-sidebar');
    if (sidebarToggle && sidebar) {
        sidebarToggle.addEventListener('click', () => {
            sidebar.classList.toggle('open');
        });
    }

    // Chart.js - Daily Order Trends (Green Curve)
    const ctx = document.getElementById('dailyOrdersChart').getContext('2d');
    const gradientFill = ctx.createLinearGradient(0, 0, 0, 200);
    gradientFill.addColorStop(0, 'rgba(5, 150, 105, 0.25)');
    gradientFill.addColorStop(1, 'rgba(5, 150, 105, 0.0)');

    const dailyOrdersChart = new Chart(ctx, {
        type: 'line',
        data: {
            labels: ['১০ আগস্ট', '১১ আগস্ট', '১২ আগস্ট', '১৩ আগস্ট', '১৪ আগস্ট', '১৫ আগস্ট', '১৬ আগস্ট'],
            datasets: [{
                label: 'দৈনিক অর্ডার',
                data: [30, 48, 62, 95, 78, 88, 115],
                borderColor: '#059669',
                backgroundColor: gradientFill,
                borderWidth: 2.5,
                fill: true,
                tension: 0.35,
                pointBackgroundColor: '#059669',
                pointBorderColor: '#ffffff',
                pointBorderWidth: 2,
                pointRadius: 4.5,
                pointHoverRadius: 6.5
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: '#0f172a',
                    titleFont: { family: 'Anek Bangla', size: 12 },
                    bodyFont: { family: 'Anek Bangla', size: 13, weight: 'bold' },
                    padding: 10,
                    cornerRadius: 8,
                    displayColors: false,
                    callbacks: {
                        label: function(context) {
                            return 'অর্ডার: ' + context.parsed.y + ' টি';
                        }
                    }
                }
            },
            scales: {
                x: {
                    grid: { display: false },
                    ticks: { font: { family: 'Anek Bangla', size: 11 }, color: '#64748b' }
                },
                y: {
                    beginAtZero: true,
                    max: 130,
                    ticks: {
                        stepSize: 30,
                        font: { family: 'Anek Bangla', size: 11 },
                        color: '#64748b'
                    },
                    grid: { color: '#f1f5f9' }
                }
            }
        }
    });

    // Chart Filter change listener
    document.getElementById('order-chart-filter').addEventListener('change', function(e) {
        const val = e.target.value;
        if (val === '7') {
            dailyOrdersChart.data.labels = ['১০ আগস্ট', '১১ আগস্ট', '১২ আগস্ট', '১৩ আগস্ট', '১৪ আগস্ট', '১৫ আগস্ট', '১৬ আগস্ট'];
            dailyOrdersChart.data.datasets[0].data = [30, 48, 62, 95, 78, 88, 115];
        } else if (val === '15') {
            dailyOrdersChart.data.labels = ['২ আগস্ট', '৪ আগস্ট', '৬ আগস্ট', '৮ আগস্ট', '১০ আগস্ট', '১২ আগস্ট', '১৪ আগস্ট', '১৬ আগস্ট'];
            dailyOrdersChart.data.datasets[0].data = [20, 35, 45, 58, 62, 95, 88, 115];
        } else {
            dailyOrdersChart.data.labels = ['১ আগস্ট', '৫ আগস্ট', '১০ আগস্ট', '১৫ আগস্ট', '২০ আগস্ট', '২৫ আগস্ট', '৩০ আগস্ট'];
            dailyOrdersChart.data.datasets[0].data = [15, 28, 48, 95, 110, 125, 140];
        }
        dailyOrdersChart.update();
    });

    // ================= Shop Registration Wizard =================
    const locationData = @Html.Raw(locationJson);
    const productCatalog = @Html.Raw(productCatalogJson);
    const registrationPrefill = @Html.Raw(prefillJson);

    const escapeHtml = value => String(value ?? '')
        .replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;').replaceAll("'", '&#039;');

    const divisionSelect = document.getElementById('reg-division');
    const districtSelect = document.getElementById('reg-district');
    const thanaSelect = document.getElementById('reg-thana');

    function fillLocationSelect(select, items, placeholder) {
        select.innerHTML = '<option value="">' + placeholder + '</option>' +
            items.map(item => '<option value="' + item.Id + '">' + escapeHtml(item.Name) + '</option>').join('');
        select.disabled = items.length === 0;
    }

    if (divisionSelect && districtSelect && thanaSelect) {
        fillLocationSelect(divisionSelect, locationData.divisions, 'বিভাগ নির্বাচন করুন');
        fillLocationSelect(districtSelect, [], 'জেলা নির্বাচন করুন');
        fillLocationSelect(thanaSelect, [], 'থানা নির্বাচন করুন');

        divisionSelect.addEventListener('change', () => {
            const districts = locationData.districts.filter(d => d.ParentId === Number(divisionSelect.value));
            fillLocationSelect(districtSelect, districts, 'জেলা নির্বাচন করুন');
            fillLocationSelect(thanaSelect, [], 'থানা নির্বাচন করুন');
        });

        districtSelect.addEventListener('change', () => {
            const thanas = locationData.thanas.filter(t => t.ParentId === Number(districtSelect.value));
            fillLocationSelect(thanaSelect, thanas, 'থানা নির্বাচন করুন');
        });

        if (registrationPrefill.divisionId) {
            divisionSelect.value = String(registrationPrefill.divisionId);
            divisionSelect.dispatchEvent(new Event('change'));
            if (registrationPrefill.districtId) {
                districtSelect.value = String(registrationPrefill.districtId);
                districtSelect.dispatchEvent(new Event('change'));
                if (registrationPrefill.thanaId) {
                    thanaSelect.value = String(registrationPrefill.thanaId);
                }
            }
        }
    }

    function setGpsButtonLoading(isLoading) {
        const btn = document.getElementById('gps-capture-btn');
        const spinner = document.getElementById('gps-spinner');
        const icon = document.getElementById('gps-icon');
        const text = document.getElementById('gps-btn-text');
        if (!btn) return;
        btn.disabled = isLoading;
        if (spinner) spinner.hidden = !isLoading;
        if (icon) icon.hidden = isLoading;
        if (text) text.textContent = isLoading ? 'অবস্থান সংগ্রহ করা হচ্ছে...' : 'বর্তমান অবস্থান সংগ্রহ করুন';
    }

    function captureGpsLocation() {
        const status = document.getElementById('gps-status');
        if (!navigator.geolocation) {
            status.textContent = 'এই ব্রাউজারে GPS সমর্থিত নয়। অনুগ্রহ করে ম্যানুয়ালি Latitude/Longitude লিখুন।';
            return;
        }
        status.textContent = 'অবস্থান সংগ্রহ করা হচ্ছে...';
        status.classList.remove('ready');
        setGpsButtonLoading(true);
        navigator.geolocation.getCurrentPosition(
            pos => {
                document.getElementById('reg-latitude').value = pos.coords.latitude.toFixed(6);
                document.getElementById('reg-longitude').value = pos.coords.longitude.toFixed(6);
                status.textContent = 'অবস্থান সংগৃহীত হয়েছে: ' + pos.coords.latitude.toFixed(6) + ', ' + pos.coords.longitude.toFixed(6);
                status.classList.add('ready');
                setGpsButtonLoading(false);
            },
            err => {
                status.textContent = 'অবস্থান সংগ্রহ করা যায়নি (' + err.message + ')। অনুগ্রহ করে ম্যানুয়ালি লিখুন।';
                setGpsButtonLoading(false);
            },
            { enableHighAccuracy: true, timeout: 10000 }
        );
    }

    function goToProductStep() {
        const pane1 = document.getElementById('wizard-pane-1');
        const fields = pane1.querySelectorAll('input, select');
        for (const field of fields) {
            if (!field.checkValidity()) {
                field.reportValidity();
                return;
            }
        }
        switchWizardStep(2);
    }

    let lastRenderedShopType = null;

    function renderProductChecklist() {
        const shopType = document.getElementById('reg-shoptype').value;
        const container = document.getElementById('reg-product-list');
        if (!shopType) {
            lastRenderedShopType = null;
            container.innerHTML = '<p class="empty-state">প্রথমে দোকানের ধরন নির্বাচন করুন।</p>';
            return;
        }
        if (shopType === lastRenderedShopType) {
            // Already rendered for this shop type - avoid wiping out the user's in-progress selections.
            return;
        }
        lastRenderedShopType = shopType;
        const currentlyChecked = new Set(
            [...container.querySelectorAll('input[type="checkbox"]:checked')].map(cb => Number(cb.value))
        );
        const previouslyChecked = currentlyChecked.size > 0
            ? currentlyChecked
            : new Set(registrationPrefill.selectedProductIds || []);
        const items = productCatalog.filter(p => p.Category === shopType);
        container.innerHTML = items.length
            ? items.map(product => '<label class="sb-check-item">' +
                '<input type="checkbox" name="Registration.SelectedProductIds" value="' + product.Id + '" ' + (previouslyChecked.has(product.Id) ? 'checked' : '') + ' onchange="updateSelectedCount()" />' +
                '<span class="sb-checkmark">✔</span>' +
                '<span class="sb-check-name">' + escapeHtml(product.Name) + ' <small>(' + escapeHtml(product.ProductCode) + ')</small></span>' +
                '</label>').join('')
            : '<p class="empty-state">এই দোকানের ধরনে কোনো সক্রিয় পণ্য পাওয়া যায়নি। অনুগ্রহ করে আগে প্রোডাক্ট পেজ থেকে পণ্য যুক্ত করুন।</p>';
        updateSelectedCount();
    }

    function goToReviewStep() {
        const checked = document.querySelectorAll('#reg-product-list input[type="checkbox"]:checked');
        if (checked.length === 0) {
            alert('অন্তত একটি পণ্য নির্বাচন করুন।');
            return;
        }
        switchWizardStep(3);
    }

    function renderReviewSummary() {
        const val = id => (document.getElementById(id) && document.getElementById(id).value) || '';
        const selectedText = select => (select && select.selectedOptions[0] && select.selectedOptions[0].text) || '';
        const products = [...document.querySelectorAll('#reg-product-list input[type="checkbox"]:checked')]
            .map(cb => cb.closest('.sb-check-item').querySelector('.sb-check-name').textContent.trim());

        document.getElementById('reg-review-summary').innerHTML =
            '<table><tbody>' +
            '<tr><th>দোকানের নাম</th><td>' + escapeHtml(val('reg-shopname')) + '</td></tr>' +
            '<tr><th>মালিকের নাম</th><td>' + escapeHtml(val('reg-ownername')) + '</td></tr>' +
            '<tr><th>মোবাইল</th><td>' + escapeHtml(val('reg-phone')) + '</td></tr>' +
            '<tr><th>ঠিকানা</th><td>' + escapeHtml(val('reg-address')) + ', ' + escapeHtml(val('reg-area')) + '</td></tr>' +
            '<tr><th>বিভাগ/জেলা/থানা</th><td>' + escapeHtml(selectedText(divisionSelect)) + ' / ' + escapeHtml(selectedText(districtSelect)) + ' / ' + escapeHtml(selectedText(thanaSelect)) + '</td></tr>' +
            '<tr><th>GPS অবস্থান</th><td>' + escapeHtml(val('reg-latitude')) + ', ' + escapeHtml(val('reg-longitude')) + '</td></tr>' +
            '<tr><th>দোকানের ধরন</th><td>' + escapeHtml(selectedText(document.getElementById('reg-shoptype'))) + '</td></tr>' +
            '<tr><th>নির্বাচিত পণ্য (' + products.length + ')</th><td>' + products.map(escapeHtml).join(', ') + '</td></tr>' +
            '</tbody></table>';
    }

    // Modal & Step Wizard Logic
    function openStepWizardModal(stepNumber = 1) {
        document.getElementById('wizardModal').style.display = 'flex';
        const shopTypeSelected = document.getElementById('reg-shoptype') && document.getElementById('reg-shoptype').value;
        if (stepNumber > 1 && !shopTypeSelected) {
            stepNumber = 1;
        }
        switchWizardStep(stepNumber);
    }

    function closeStepWizardModal() {
        document.getElementById('wizardModal').style.display = 'none';
    }

    function switchWizardStep(stepNumber) {
        for (let i = 1; i <= 3; i++) {
            const pane = document.getElementById('wizard-pane-' + i);
            const tab = document.getElementById('tab-step-' + i);
            if (pane) pane.style.display = (i === stepNumber) ? 'block' : 'none';
            if (tab) {
                if (i === stepNumber) tab.classList.add('active');
                else tab.classList.remove('active');
            }
        }
        // Always (re)build the target pane's dynamic content so every navigation
        // path - Next/Back buttons, the top tabs, or opening the modal directly -
        // stays in sync instead of only refreshing on one specific button click.
        if (stepNumber === 2) renderProductChecklist();
        if (stepNumber === 3) renderReviewSummary();
    }

    function updateSelectedCount() {
        const checkboxes = document.querySelectorAll('#reg-product-list input[type="checkbox"]');
        let checkedCount = 0;
        checkboxes.forEach(cb => { if (cb.checked) checkedCount++; });
        const btn = document.getElementById('wz-btn-step2');
        if (btn) btn.textContent = checkedCount > 0 ? ('পরবর্তী: যাচাই করুন (' + checkedCount + ')') : 'পরবর্তী: যাচাই করুন';
    }

    function filterWizardProducts() {
        const q = document.getElementById('wz-product-search').value.toLowerCase();
        const items = document.querySelectorAll('#reg-product-list .sb-check-item');
        items.forEach(item => {
            const text = item.querySelector('.sb-check-name').textContent.toLowerCase();
            item.style.display = text.includes(q) ? 'flex' : 'none';
        });
    }

    function toggleAllProducts(checked) {
        const items = document.querySelectorAll('#reg-product-list .sb-check-item');
        items.forEach(item => {
            // Only touch products currently visible under the active search filter.
            if (item.style.display === 'none') return;
            const checkbox = item.querySelector('input[type="checkbox"]');
            if (checkbox) checkbox.checked = checked;
        });
        updateSelectedCount();
    }

    // Give feedback while the entry is being saved: block double-submits, revalidate
    // every pane (a required field in a hidden earlier pane doesn't stop native
    // submission), and jump back to whichever step needs attention.
    const shopRegistrationForm = document.getElementById('shopRegistrationForm');
    if (shopRegistrationForm) {
        shopRegistrationForm.addEventListener('submit', function (event) {
            const allFields = this.querySelectorAll('input, select');
            for (const field of allFields) {
                if (!field.checkValidity()) {
                    const pane = field.closest('.sb-wizard-pane');
                    if (pane) {
                        const stepNum = Number(pane.id.replace('wizard-pane-', ''));
                        if (stepNum) switchWizardStep(stepNum);
                    }
                    field.reportValidity();
                    event.preventDefault();
                    return;
                }
            }
            const submitBtn = document.getElementById('reg-submit-btn');
            const spinner = document.getElementById('reg-submit-spinner');
            const text = document.getElementById('reg-submit-text');
            if (submitBtn) submitBtn.disabled = true;
            if (spinner) spinner.hidden = false;
            if (text) text.textContent = 'সংরক্ষণ করা হচ্ছে...';
        });
    }
</script>
}
@if (hasRegistrationErrors)
{
    <script>document.addEventListener('DOMContentLoaded', () => openStepWizardModal(1));</script>
}
