@model FieldOfficerDashboardViewModel
@{
    ViewData["Title"] = "অফিসার প্রোফাইল - Smart Bazar";
    ViewData["ActivePage"] = "Profile";
}

<div class="sb-app-layout">
    <!-- Sidebar -->
    <partial name="_Sidebar" model="Model" view-data='new ViewDataDictionary(ViewData) { { "ActivePage", "Profile" } }' />

    <!-- Main Content -->
    <main class="sb-main-content">
        <!-- Top Navigation Bar -->
        <header class="sb-topbar">
            <div class="sb-topbar-left">
                <a href="/FieldForce" class="sb-menu-toggle" style="text-decoration:none; display:flex; align-items:center;">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                </a>
                <div class="sb-user-greeting">
                    <div class="sb-greeting-title">
                        ফিল্ড অফিসার প্রোফাইল ও বিবরণ
                    </div>
                    <span class="sb-user-role">Smart Bazar ফিল্ড ফোর্স নেটওয়ার্ক</span>
                </div>
            </div>

            <div class="sb-topbar-right">
                <span class="sb-verified-pill" style="padding: 6px 12px; font-size: 12px;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="#059669"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
                    ভেরিফাইড ফিল্ড অফিসার
                </span>
            </div>
        </header>

        <!-- Body Content -->
        <div class="sb-dashboard-body">
            <div class="sb-profile-grid">
                <!-- Officer Card -->
                <div class="sb-profile-card">
                    <div class="sb-profile-avatar-wrap">
                        @if (!string.IsNullOrWhiteSpace(Model.ProfilePictureUrl))
                        {
                            <img src="@Model.ProfilePictureUrl" alt="@Model.OfficerName" style="width: 100px; height: 100px; border-radius: 50%; object-fit: cover; border: 3px solid #10b981; margin: 0 auto 14px; display: block; box-shadow: 0 8px 20px rgba(16, 185, 129, 0.25);" />
                        }
                        else
                        {
                            <div class="sb-profile-avatar" style="width: 100px; height: 100px; border-radius: 50%; background: linear-gradient(135deg, #10b981, #0f766e); color: #fff; display: grid; place-items: center; font-size: 36px; font-weight: 900; margin: 0 auto 14px; box-shadow: 0 8px 20px rgba(16, 185, 129, 0.25);">
                                @(string.IsNullOrWhiteSpace(Model.OfficerName) ? "F" : Model.OfficerName[..1].ToUpperInvariant())
                            </div>
                        }
                        <h3>@(string.IsNullOrWhiteSpace(Model.OfficerName) ? "মোঃ রফিকুল ইসলাম" : Model.OfficerName)</h3>
                        <span class="sb-profile-tag">🛡️ ভেরিফাইড ফিল্ড অফিসার</span>
                        <small style="display: block; color: #64748b; font-size: 12px; margin-top: 4px;">ল্যান্ডিং পেজে এই ছবিটি প্রদর্শিত হবে</small>
                    </div>

                    <form asp-action="UpdateProfilePicture" method="post" enctype="multipart/form-data" style="margin: 16px 0; padding: 14px; background: #f8fafc; border-radius: 12px; border: 1px solid #e2e8f0;">
                        <label style="display: block; font-size: 12px; font-weight: 700; color: #475569; margin-bottom: 6px;">নতুন ছবি আপলোড করুন</label>
                        <input type="file" name="profilePicture" accept="image/jpeg,image/png,image/webp" required style="width: 100%; font-size: 12px; margin-bottom: 10px;" />
                        <button type="submit" style="width: 100%; padding: 8px 14px; border-radius: 8px; background: #10b981; color: #fff; border: 0; font-weight: 800; cursor: pointer;">ছবি সেভ করুন</button>
                    </form>

                    <div class="sb-profile-stats">
                        <div class="sb-pstat">
                            <span class="sb-pstat-num">@Model.Shops.Count</span>
                            <span class="sb-pstat-lbl">অনবোর্ড দোকান</span>
                        </div>
                        <div class="sb-pstat">
                            <span class="sb-pstat-num">@Model.Products.Count</span>
                            <span class="sb-pstat-lbl">ক্যাটালগ পণ্য</span>
                        </div>
                        <div class="sb-pstat">
                            <span class="sb-pstat-num">৪.৯ ★</span>
                            <span class="sb-pstat-lbl">রেটিং</span>
                        </div>
                    </div>
                </div>

                <!-- Officer Details Card -->
                <div class="sb-profile-details-card">
                    <div class="sb-card-header">
                        <span class="sb-badge-pill">অফিশিয়াল বিবরণ</span>
                        <h3 style="margin-top: 4px;">দায়িত্বপ্রাপ্ত এলাকা ও তথ্য</h3>
                    </div>

                    <div class="sb-details-list">
                        <div class="sb-detail-row">
                            <span class="sb-detail-lbl">নির্ধারিত টেরিটরি / এলাকা</span>
                            <strong class="sb-detail-val">ঢাকা মেট্রো (মিরপুর জোন - ১০, ১১, ১২ ও পল্লবী)</strong>
                        </div>
                        <div class="sb-detail-row">
                            <span class="sb-detail-lbl">মোবাইল নম্বর</span>
                            <strong class="sb-detail-val">01700-123456</strong>
                        </div>
                        <div class="sb-detail-row">
                            <span class="sb-detail-lbl">অফিশিয়াল ইমেইল</span>
                            <strong class="sb-detail-val">fieldforce@smartbazar.com</strong>
                        </div>
                        <div class="sb-detail-row">
                            <span class="sb-detail-lbl">যোগদানের তারিখ</span>
                            <strong class="sb-detail-val">০১ জানুয়ারি, ২০২৬</strong>
                        </div>
                        <div class="sb-detail-row">
                            <span class="sb-detail-lbl">সুপারভাইজার / জোনাল হেড</span>
                            <strong class="sb-detail-val">তানভীর আহমেদ (HQ Operations)</strong>
                        </div>
                    </div>

                    <div class="sb-profile-action-box" style="margin-top: 24px; padding-top: 18px; border-top: 1px solid #f1f5f9;">
                        <a href="/FieldForce/Shops" class="sb-btn-primary-block" style="text-decoration: none; text-align: center;">
                            <span>আমার আওতাধীন দোকান সমূহ দেখুন</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

@section Styles {
<style>
    .sb-profile-grid {
        display: grid;
        grid-template-columns: 340px minmax(0, 1fr);
        gap: 24px;
        max-width: 1000px;
        margin: 0 auto;
    }

    .sb-profile-card, .sb-profile-details-card {
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        padding: 24px;
    }

    .sb-profile-avatar-wrap {
        text-align: center;
        padding-bottom: 20px;
        border-bottom: 1px solid #f1f5f9;
    }

    .sb-profile-avatar {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: #ecfdf5;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 38px;
        margin: 0 auto 12px;
        border: 2px solid #a7f3d0;
    }

    .sb-profile-avatar-wrap h3 {
        margin: 0 0 4px;
        font-size: 18px;
        font-weight: 800;
        color: #0f172a;
    }

    .sb-profile-tag {
        display: block;
        font-size: 12px;
        font-weight: 700;
        color: #059669;
        margin-bottom: 4px;
    }

    .sb-profile-code {
        display: inline-block;
        font-size: 11px;
        font-weight: 800;
        background: #f1f5f9;
        color: #475569;
        padding: 2px 8px;
        border-radius: 4px;
    }

    .sb-profile-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
        margin-top: 20px;
        text-align: center;
    }

    .sb-pstat {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 10px 6px;
    }

    .sb-pstat-num {
        display: block;
        font-size: 16px;
        font-weight: 800;
        color: #0f172a;
    }

    .sb-pstat-lbl {
        font-size: 11px;
        color: #64748b;
        font-weight: 600;
    }

    .sb-details-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
        margin-top: 16px;
    }

    .sb-detail-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 12px;
        border-bottom: 1px solid #f1f5f9;
    }

    .sb-detail-lbl {
        font-size: 13px;
        color: #64748b;
        font-weight: 600;
    }

    .sb-detail-val {
        font-size: 13.5px;
        color: #0f172a;
        font-weight: 700;
        text-align: right;
    }

    @@media (max-width: 800px) {
        .sb-profile-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
}
