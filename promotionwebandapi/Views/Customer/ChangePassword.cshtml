@model CustomerDashboardViewModel
@{
    ViewData["Title"] = "Change Password";
    ViewData["ActivePage"] = "ChangePassword";
}

<main class="app-page shop-theme shop-portal-page customer-portal-page">
    <div class="shop-portal-shell">
        <partial name="_Sidebar" model="Model" />

        <section class="shop-page-content">
            <header class="shop-page-header">
                <div>
                    <span>SECURITY</span>
                    <h1>পাসওয়ার্ড পরিবর্তন</h1>
                    <p>আপনার customer account-এর password পরিবর্তন করুন।</p>
                </div>
            </header>

            <section class="panel customer-password-panel">
                <h2>পাসওয়ার্ড পরিবর্তন করুন</h2>
                <p class="customer-form-copy">বর্তমান password এবং নতুন password লিখে সংরক্ষণ করুন।</p>

                <form id="customer-change-password-form" class="form-stack">
                    @Html.AntiForgeryToken()
                    <label for="old-password">বর্তমান পাসওয়ার্ড</label>
                    <input id="old-password" name="OldPassword" type="password" required autocomplete="current-password" />

                    <label for="new-password">নতুন পাসওয়ার্ড</label>
                    <input id="new-password" name="NewPassword" type="password" required minlength="4" autocomplete="new-password" />

                    <label for="confirm-password">নতুন পাসওয়ার্ড নিশ্চিত করুন</label>
                    <input id="confirm-password" name="ConfirmPassword" type="password" required minlength="4" autocomplete="new-password" />

                    <button class="btn-primary" type="submit">পাসওয়ার্ড সংরক্ষণ করুন</button>
                </form>

                <div class="customer-form-message" id="customer-password-message" role="alert" hidden></div>
            </section>
        </section>
    </div>
</main>

@section Scripts {
    <script>
        (() => {
            const form = document.getElementById("customer-change-password-form");
            const button = form.querySelector('button[type="submit"]');
            const message = document.getElementById("customer-password-message");

            const showMessage = (text, type) => {
                message.textContent = text;
                message.className = `customer-form-message ${type}`;
                message.hidden = false;
            };

            form.addEventListener("submit", async event => {
                event.preventDefault();
                const oldPassword = document.getElementById("old-password").value;
                const newPassword = document.getElementById("new-password").value;
                const confirmPassword = document.getElementById("confirm-password").value;

                if (newPassword !== confirmPassword) {
                    showMessage("নতুন পাসওয়ার্ড এবং নিশ্চিতকরণ পাসওয়ার্ড মেলেনি।", "error");
                    return;
                }

                button.disabled = true;
                button.textContent = "সংরক্ষণ হচ্ছে...";
                message.hidden = true;

                try {
                    const response = await fetch('@Url.Action("ChangePassword", "Customer")', {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            "RequestVerificationToken": form.querySelector('input[name="__RequestVerificationToken"]').value
                        },
                        body: JSON.stringify({ oldPassword, newPassword, confirmPassword })
                    });
                    const result = await response.json();
                    if (!response.ok) throw new Error(result.message || "পাসওয়ার্ড পরিবর্তন করা যায়নি।");
                    showMessage(result.message, "success");
                    form.reset();
                } catch (error) {
                    showMessage(error.message || "পাসওয়ার্ড পরিবর্তন করা যায়নি।", "error");
                } finally {
                    button.disabled = false;
                    button.textContent = "পাসওয়ার্ড সংরক্ষণ করুন";
                }
            });
        })();
    </script>
}
