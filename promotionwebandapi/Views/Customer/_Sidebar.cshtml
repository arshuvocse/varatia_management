@model CustomerDashboardViewModel
@{
    var activePage = ViewData["ActivePage"]?.ToString() ?? "Dashboard";
}

<aside class="sb-cust-sidebar">
    <div class="sb-cust-brand">
        <div class="sb-cust-brand-logo">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="21" r="1"></circle>
                <circle cx="20" cy="21" r="1"></circle>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
            </svg>
            <div class="sb-cust-brand-text">
                <span class="sb-brand-title">Smart<span class="sb-accent">Bazar</span></span>
                <small class="sb-cust-role-pill">ক্রেতা অ্যাকাউন্ট</small>
            </div>
        </div>
    </div>

    <nav class="sb-cust-nav" aria-label="ক্রেতা মেনু">
        <a class="sb-cust-nav-item @(activePage == "Dashboard" ? "active" : "")" asp-action="Dashboard">
            <span class="sb-nav-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </span>
            <span>হোম বাজার</span>
        </a>

        <a class="sb-cust-nav-item @(activePage == "PlaceOrder" ? "active" : "")" asp-action="PlaceOrder">
            <span class="sb-nav-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" x2="12" y1="5" y2="19"/><line x1="5" x2="19" y1="12" y2="12"/></svg>
            </span>
            <span>নতুন অর্ডার</span>
        </a>

        <a class="sb-cust-nav-item @(activePage == "Orders" ? "active" : "")" asp-action="Orders">
            <span class="sb-nav-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><line x1="3" x2="21" y1="6" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            </span>
            <span>আমার অর্ডার</span>
        </a>

        <a class="sb-cust-nav-item @(activePage == "Dues" ? "active" : "")" asp-action="Dues">
            <span class="sb-nav-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
            </span>
            <span>ক্রেডিট (বাকি খাতা)</span>
            @if (Model.TotalDueAmount > 0)
            {
                <span class="sb-badge-alert">৳@Model.TotalDueAmount.ToString("N0")</span>
            }
        </a>

        <a class="sb-cust-nav-item @(activePage == "Shops" ? "active" : "")" asp-action="Shops">
            <span class="sb-nav-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"/><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4"/></svg>
            </span>
            <span>কাছের দোকান</span>
        </a>

        <a class="sb-cust-nav-item @(activePage == "Chat" ? "active" : "")" asp-action="Chat">
            <span class="sb-nav-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </span>
            <span>লাইভ চ্যাট</span>
            <span class="sb-badge-alert" data-chat-notification-badge hidden="@(Model.UnreadChatCount == 0)">@Model.UnreadChatCount</span>
        </a>

        <a class="sb-cust-nav-item @(activePage == "Wallet" ? "active" : "")" asp-action="Wallet">
            <span class="sb-nav-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"/><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/></svg>
            </span>
            <span>রিওয়ার্ড ও ওয়ালেট</span>
        </a>

        <a class="sb-cust-nav-item @(activePage == "Loan" ? "active" : "")" asp-action="Loan">
            <span class="sb-nav-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#e11d48" stroke-width="2"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/><path d="M7 15h.01M11 15h2"/></svg>
            </span>
            <span style="color: #e11d48; font-weight: 700;">⚡ ডিজিটাল লোন</span>
        </a>

        <a class="sb-cust-nav-item @(activePage == "AgentLocation" ? "active" : "")" asp-action="AgentLocation">
            <span class="sb-nav-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            </span>
            <span>এরিয়া এজেন্ট অফিস</span>
        </a>

        <a class="sb-cust-nav-item @(activePage == "Profile" ? "active" : "")" asp-action="Profile">
            <span class="sb-nav-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </span>
            <span>আমার প্রোফাইল</span>
        </a>
    </nav>

    <div class="sb-cust-sidebar-footer">
        <form asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="sb-cust-logout-btn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
                <span>লগআউট</span>
            </button>
        </form>
    </div>
</aside>
