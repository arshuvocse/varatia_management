@model AgentDashboardViewModel
@{ ViewData["Title"] = "ডেলিভারি অর্ডার"; ViewData["ActivePage"] = "Orders"; }
<main class="app-page shop-theme shop-portal-page agent-portal-page"><div class="shop-portal-shell">
<partial name="_Sidebar" model="Model" /><section class="shop-page-content">
<header class="shop-page-header"><div><span>অর্ডার পর্যবেক্ষণ</span><h1>ডেলিভারি অর্ডার</h1><p>Monitor assignments across all shops and riders in your district team.</p></div><span class="table-chip">@Model.Assignments.Count assignments</span></header>
<partial name="_Messages" /><section class="agent-stat-grid compact"><article><span>সক্রিয়</span><strong>@Model.ActiveAssignments</strong></article><article><span>Delivered</span><strong>@Model.DeliveredAssignments</strong></article><article><span>ব্যর্থ / ফেরত</span><strong>@Model.FailedAssignments</strong></article><article><span>Collected</span><strong>৳ @Model.DeliveredCollection.ToString("N0")</strong></article></section>
<section class="panel"><div class="table-scroll"><table class="registered-shops-table"><thead><tr><th>অর্ডার</th><th>দায়িত্ব দেওয়ার সময়</th><th>দোকান</th><th>ক্রেতা</th><th>ডেলিভারি কর্মী</th><th>টাকার পরিমাণ</th><th>অবস্থা</th></tr></thead><tbody>@foreach (var x in Model.Assignments) { <tr><td><strong>#@x.OrderId</strong></td><td>@x.AssignedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</td><td>@x.ShopName<br /><small>@x.ShopPhone</small></td><td>@x.CustomerName<br /><small>@x.CustomerPhone</small></td><td>@x.DeliveryManName<br /><small>@x.DeliveryManPhone</small></td><td>৳ @x.CollectionAmount.ToString("N2")</td><td><span class="status-chip @(x.Status == DeliveryStatus.Delivered ? "paid" : "pending")">@UiText.Status(x.Status)</span></td></tr> }</tbody></table></div>@if (Model.Assignments.Count == 0) { <p class="empty-state">এখনও কোনো ডেলিভারি কাজ নেই।</p> }</section>
</section></div></main>
