@model AgentDashboardViewModel
@{
    ViewData["Title"] = "Agent Reports"; ViewData["ActivePage"] = "Reports";
    var riderReports = Model.DeliveryMen.Select(r => new { Rider = r, Orders = Model.Assignments.Where(x => x.DeliveryManId == r.Id).ToList() }).OrderByDescending(x => x.Orders.Count(o => o.Status == DeliveryStatus.Delivered)).ToList();
}
<main class="app-page shop-theme shop-portal-page agent-portal-page"><div class="shop-portal-shell">
<partial name="_Sidebar" model="Model" /><section class="shop-page-content">
<header class="shop-page-header"><div><span>কর্মদক্ষতা</span><h1>রিপোর্ট</h1><p>দলের বৃদ্ধি, ডেলিভারি ও টাকা Collectionের সারসংক্ষেপ।</p></div><span class="table-chip">@DateTime.Now.ToString("MMMM yyyy")</span></header>
<partial name="_Messages" /><section class="agent-stat-grid"><article><span>এই মাসের দোকান</span><strong>@Model.Shops.Count(x => x.RegisteredAt.Year == DateTime.Now.Year && x.RegisteredAt.Month == DateTime.Now.Month)</strong></article><article><span>এই মাসের ডেলিভারি</span><strong>@Model.Assignments.Count(x => x.AssignedAt.Year == DateTime.Now.Year && x.AssignedAt.Month == DateTime.Now.Month)</strong></article><article><span>Deliveredের হার</span><strong>@(Model.Assignments.Count == 0 ? 0 : Math.Round(Model.DeliveredAssignments * 100m / Model.Assignments.Count, 1))%</strong></article><article><span>Delivered collection</span><strong>৳ @Model.DeliveredCollection.ToString("N0")</strong></article></section>
<section class="panel"><div class="panel-title-row"><h2>ফিল্ড কর্মী performance</h2></div><div class="table-scroll"><table class="registered-shops-table"><thead><tr><th>ফিল্ড কর্মী</th><th>মোবাইল</th><th>Total shops</th><th>এই মাসে</th></tr></thead><tbody>@foreach (var x in Model.FieldOfficers) { <tr><td><strong>@x.Name</strong></td><td>@x.Phone</td><td>@Model.Shops.Count(s => s.FieldOfficerUserId == x.Id)</td><td>@Model.Shops.Count(s => s.FieldOfficerUserId == x.Id && s.RegisteredAt.Year == DateTime.Now.Year && s.RegisteredAt.Month == DateTime.Now.Month)</td></tr> }</tbody></table></div></section>
<section class="panel"><div class="panel-title-row"><h2>ডেলিভারি কর্মীর কাজের হিসাব</h2></div><div class="table-scroll"><table class="registered-shops-table"><thead><tr><th>ডেলিভারি কর্মী</th><th>মোট</th><th>Delivered</th><th>সক্রিয়</th><th>ব্যর্থ / ফেরত</th><th>Collection</th></tr></thead><tbody>@foreach (var x in riderReports) { <tr><td><strong>@x.Rider.Name</strong></td><td>@x.Orders.Count</td><td>@x.Orders.Count(o => o.Status == DeliveryStatus.Delivered)</td><td>@x.Orders.Count(o => o.Status is not DeliveryStatus.Delivered and not DeliveryStatus.Failed and not DeliveryStatus.Returned and not DeliveryStatus.Cancelled and not DeliveryStatus.Rejected)</td><td>@x.Orders.Count(o => o.Status is DeliveryStatus.Failed or DeliveryStatus.Returned)</td><td>৳ @x.Orders.Where(o => o.Status == DeliveryStatus.Delivered).Sum(o => o.CashCollectedAmount ?? o.CollectionAmount).ToString("N0")</td></tr> }</tbody></table></div></section>
</section></div></main>
