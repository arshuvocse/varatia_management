@model AgentDashboardViewModel
@{ ViewData["Title"] = "Delivery Team"; ViewData["ActivePage"] = "DeliveryTeam"; var districtId = Model.District?.DistrictId ?? 0; }
<main class="app-page shop-theme shop-portal-page agent-portal-page"><div class="shop-portal-shell">
<partial name="_Sidebar" model="Model" /><section class="shop-page-content">
<header class="shop-page-header"><div><span>ডেলিভারি পরিচালনা</span><h1>ডেলিভারি দল</h1><p>জেলার ডেলিভারি কর্মী নিবন্ধন, যাচাই ও পরিচালনা করুন।</p></div><span class="table-chip">@Model.ActiveDeliveryMen active</span></header>
<partial name="_Messages" />
<section class="panel"><details class="agent-registration-details"><summary>ডেলিভারি কর্মী নিবন্ধন</summary>
<form asp-action="RegisterDeliveryMan" method="post" enctype="multipart/form-data" class="delivery-form-grid">
<label>নাম *<input asp-for="DeliveryRegistration.Name" required /></label><label>মোবাইল *<input asp-for="DeliveryRegistration.Phone" required pattern="\d{11}" /></label><label>পাসওয়ার্ড *<input asp-for="DeliveryRegistration.Password" type="password" required minlength="4" /></label>
<label>বিভাগ *<select asp-for="DeliveryRegistration.DivisionId" class="js-division" required><option value="">বিভাগ নির্বাচন করুন</option>@foreach (var x in Model.Locations.Divisions) { <option value="@x.Id" selected="@(x.Id == Model.District?.DivisionId)">@x.Name</option> }</select></label>
<label>জেলা *<select asp-for="DeliveryRegistration.DistrictId" class="js-district" required><option value="">জেলা নির্বাচন করুন</option>@foreach (var x in Model.Locations.Districts) { <option value="@x.Id" data-parent="@x.ParentId" selected="@(x.Id == districtId)">@x.Name</option> }</select></label>
<label>থানা *<select asp-for="DeliveryRegistration.ThanaId" class="js-thana" required><option value="">থানা নির্বাচন করুন</option>@foreach (var x in Model.Locations.Thanas) { <option value="@x.Id" data-parent="@x.ParentId">@x.Name</option> }</select></label>
<label class="wide">ঠিকানা *<input asp-for="DeliveryRegistration.Address" required /></label><label>অক্ষাংশ *<input asp-for="DeliveryRegistration.Latitude" type="number" step="0.000001" required /></label><label>দ্রাঘিমাংশ *<input asp-for="DeliveryRegistration.Longitude" type="number" step="0.000001" required /></label>
<label>জন্মতারিখ<input asp-for="DeliveryRegistration.DateOfBirth" type="date" /></label><label>জরুরি যোগাযোগ<input asp-for="DeliveryRegistration.EmergencyContact" /></label><label>জাতীয় পরিচয়পত্র নম্বর<input asp-for="DeliveryRegistration.NidNumber" /></label>
<label>যানবাহনের ধরন<input asp-for="DeliveryRegistration.VehicleType" /></label><label>যানবাহনের নম্বর<input asp-for="DeliveryRegistration.VehicleNumber" /></label><label>ড্রাইভিং লাইসেন্স<input asp-for="DeliveryRegistration.DrivingLicenseNumber" /></label>
<label>প্রোফাইল ছবি<input asp-for="DeliveryRegistration.ProfilePhoto" type="file" accept="image/jpeg,image/png,image/webp" /></label><label>জাতীয় পরিচয়পত্রের সামনের ছবি<input asp-for="DeliveryRegistration.NidFrontPhoto" type="file" accept="image/jpeg,image/png,image/webp" /></label><label>জাতীয় পরিচয়পত্রের পেছনের ছবি<input asp-for="DeliveryRegistration.NidBackPhoto" type="file" accept="image/jpeg,image/png,image/webp" /></label><label>লাইসেন্সের ছবি<input asp-for="DeliveryRegistration.DrivingLicensePhoto" type="file" accept="image/jpeg,image/png,image/webp" /></label>
<div class="wide"><button class="btn-primary" type="submit">ডেলিভারি অ্যাকাউন্ট তৈরি করুন</button></div></form></details></section>
<section class="panel"><div class="panel-title-row"><h2>জেলার ডেলিভারি কর্মী</h2><strong>@Model.DeliveryMen.Count</strong></div><div class="delivery-team-grid">
@foreach (var person in Model.DeliveryMen) { <article class="delivery-person-card">@if (!string.IsNullOrWhiteSpace(person.ProfilePhotoUrl)) { <img src="@person.ProfilePhotoUrl" alt="@person.Name" /> } else { <span class="delivery-avatar">@person.Name[..1].ToUpperInvariant()</span> }<div><h3>@person.Name</h3><a href="tel:@person.Phone">@person.Phone</a><p>@person.ThanaName, @person.DistrictName</p><small>@person.VehicleType @person.VehicleNumber</small><br /><span class="status-chip @(person.IsActive ? "paid" : "pending")">@(person.IsActive ? person.Availability : "Inactive")</span><small class="agent-doc-state">@(!string.IsNullOrWhiteSpace(person.NidNumber) ? "NID" : "পরিচয়পত্র নেই") · @(!string.IsNullOrWhiteSpace(person.DrivingLicenseNumber) ? "License" : "লাইসেন্স নেই")</small></div><form asp-action="SetDeliveryManActive" method="post"><input type="hidden" name="deliveryManId" value="@person.Id" /><input type="hidden" name="isActive" value="@(!person.IsActive)" /><button class="btn-light" type="submit">@(person.IsActive ? "Deactivate" : "Activate")</button></form></article> }
@if (Model.DeliveryMen.Count == 0) { <p class="empty-state">এখনও কোনো ডেলিভারি কর্মী নিবন্ধিত হয়নি।</p> }</div></section>
</section></div></main>
@section Scripts { <script>document.addEventListener("DOMContentLoaded",()=>{const d=document.querySelector(".js-division"),s=document.querySelector(".js-district"),t=document.querySelector(".js-thana");if(!d||!s||!t)return;const f=(e,p)=>{for(const o of e.options){if(o.value)o.hidden=!!p&&o.dataset.parent!==p}if(e.selectedOptions[0]?.hidden)e.value=""};const u=()=>f(t,s.value);d.addEventListener("change",()=>{f(s,d.value);u()});s.addEventListener("change",u);f(s,d.value);u()});</script> }
