@model AgentDashboardViewModel
@{ ViewData["Title"] = "Agent Profile"; ViewData["ActivePage"] = "Profile"; }
<main class="app-page shop-theme shop-portal-page agent-portal-page"><div class="shop-portal-shell">
<partial name="_Sidebar" model="Model" /><section class="shop-page-content">
<header class="shop-page-header"><div><span>অ্যাকাউন্ট</span><h1>প্রোফাইল ও পাসওয়ার্ড</h1><p>অ্যাকাউন্টের তথ্য, ছবি ও লগইন পাসওয়ার্ড পরিচালনা করুন।</p></div></header>
<partial name="_Messages" /><div class="agent-two-column">

<section class="panel">
    <h2>প্রোফাইল ছবি</h2>
    <div style="display: flex; align-items: center; gap: 20px; margin-bottom: 18px;">
        @if (!string.IsNullOrWhiteSpace(Model.ProfilePictureUrl))
        {
            <img src="@Model.ProfilePictureUrl" alt="@Model.AgentName" style="width: 84px; height: 84px; border-radius: 50%; object-fit: cover; border: 3px solid #2563eb; box-shadow: 0 6px 16px rgba(37,99,235,0.2);" />
        }
        else
        {
            <div style="width: 84px; height: 84px; border-radius: 50%; background: linear-gradient(135deg, #2563eb, #7c3aed); color: #fff; display: grid; place-items: center; font-size: 32px; font-weight: 800; box-shadow: 0 6px 16px rgba(37,99,235,0.2);">
                @(string.IsNullOrWhiteSpace(Model.AgentName) ? "A" : Model.AgentName[..1].ToUpperInvariant())
            </div>
        }
        <div>
            <h3 style="margin: 0 0 4px; font-size: 18px;">@Model.AgentName</h3>
            <span style="display: inline-block; padding: 3px 10px; border-radius: 999px; background: #eff6ff; color: #2563eb; font-weight: 800; font-size: 12px;">👑 অনুমোদিত এরিয়া এজেন্ট</span>
            <small style="display: block; color: var(--muted); margin-top: 4px;">ল্যান্ডিং পেজে গ্রাহক ও দোকানদারদের সামনে এই ছবিটি প্রদর্শিত হবে।</small>
        </div>
    </div>
    <form asp-action="UpdateProfilePicture" method="post" enctype="multipart/form-data" class="form-stack">
        <label>নতুন ছবি আপলোড করুন</label>
        <input type="file" name="profilePicture" accept="image/jpeg,image/png,image/webp" required />
        <button class="btn-primary" type="submit">ছবি সংরক্ষণ করুন</button>
    </form>
</section>

<section class="panel"><h2>এজেন্ট প্রোফাইল</h2><form asp-action="UpdateProfile" method="post" class="form-stack"><label>নাম</label><input name="name" value="@Model.AgentName" required maxlength="150" /><label>মোবাইল</label><input value="@Model.AgentPhone" readonly /><label>Assigned division</label><input value="@(Model.District?.DivisionName ?? "নির্ধারিত নয়")" readonly /><label>Assigned district</label><input value="@(Model.District?.DistrictName ?? "নির্ধারিত নয়")" readonly /><button class="btn-primary" type="submit">প্রোফাইল আপডেট করুন</button></form></section>

<section class="panel">
    <h2>📍 এজেন্ট অফিস এড্রেস ও লোকেশন</h2>
    <p style="color: var(--muted); font-size: 13px; margin-bottom: 15px;">গ্রাহক ও দোকানদাররা এই অফিস ঠিকানা ও ম্যাপ লোকেশন দেখতে পাবেন।</p>
    <form asp-action="UpdateOfficeLocation" method="post" class="form-stack">
        <label>অফিসের নাম</label>
        <input name="officeName" placeholder="যেমন: আমার ঠিকানা এরিয়া অফিস" value="আমার ঠিকানা এরিয়া অফিস" required maxlength="150" />
        
        <label>বিস্তারিত ঠিকানা (রোড / বাড়ি / মার্কেট)</label>
        <input name="officeAddress" placeholder="যেমন: বাড়ি # ১২, রোড # ৪, ব্লক # সি" required maxlength="250" />

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
            <div>
                <label>রোড / লেন নং</label>
                <input name="roadNo" placeholder="রোড নং ৪" maxlength="50" />
            </div>
            <div>
                <label>এলাকা / পাড়া</label>
                <input name="areaName" placeholder="মিরপুর ১০" maxlength="100" />
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
            <div>
                <label>থানা</label>
                <input name="thana" placeholder="মিরপুর" maxlength="100" />
            </div>
            <div>
                <label>যোগাযোগের হটলাইন</label>
                <input name="contactPhone" value="@Model.AgentPhone" maxlength="30" />
            </div>
        </div>

        <label>অফিস খোলার সময়</label>
        <input name="officeHours" value="সকাল ৯:০০ - রাত ৮:০০ (প্রতিদিন)" maxlength="100" />

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
            <div>
                <label>অক্ষাংশ (Latitude)</label>
                <input type="number" step="any" name="latitude" value="23.8103" />
            </div>
            <div>
                <label>দ্রাঘিমাংশ (Longitude)</label>
                <input type="number" step="any" name="longitude" value="90.4125" />
            </div>
        </div>

        <button class="btn-primary" type="submit">অফিস লোকেশন সংরক্ষণ করুন</button>
    </form>
</section>
@if (Model.District is null)
{
<section class="panel"><h2>কাজের জেলা নির্ধারণ</h2><p>সেবা অনুরোধ ও জেলা-ভিত্তিক ডেলিভারি পরিচালনার জন্য প্রথমে একটি জেলা নির্বাচন করুন। একবার নির্ধারিত হলে জেলা পরিবর্তন করা যাবে না।</p><form asp-action="AssignDistrict" method="post" class="form-stack"><label>জেলা</label><select name="districtId" required><option value="">জেলা নির্বাচন করুন</option>@foreach (var district in Model.Locations.Districts) { <option value="@district.Id">@district.Name</option> }</select><button class="btn-primary" type="submit">জেলা নির্ধারণ করুন</button></form></section>
}
<section class="panel"><h2>পাসওয়ার্ড পরিবর্তন</h2><form asp-action="ChangePassword" method="post" class="form-stack"><label>বর্তমান পাসওয়ার্ড</label><input asp-for="Password.OldPassword" type="password" required /><label>নতুন পাসওয়ার্ড</label><input asp-for="Password.NewPassword" type="password" minlength="4" required /><label>পাসওয়ার্ড নিশ্চিত করুন</label><input asp-for="Password.ConfirmPassword" type="password" minlength="4" required /><button class="btn-primary" type="submit">পাসওয়ার্ড পরিবর্তন</button></form></section>
</div></section></div></main>
