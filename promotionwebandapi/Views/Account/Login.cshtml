@model LoginViewModel
@{
    ViewData["Title"] = "লগইন";
}

<main class="auth-page">
    <section class="auth-card">
        <a class="brand compact" asp-controller="Home" asp-action="Index">
            <img src="~/images/amar_thikanaa_icon.png" alt="" />
            <span><strong>আমার ঠিকানা</strong><small>সব ধরনের অ্যাকাউন্টে লগইন</small></span>
        </a>
        <h1>লগইন করুন</h1>
        <p>মোবাইল নম্বর ও পাসওয়ার্ড দিয়ে আপনার অ্যাকাউন্টে প্রবেশ করুন।</p>

        <form asp-action="Login" method="post" class="form-stack">
            <div asp-validation-summary="ModelOnly" class="validation"></div>

            <label asp-for="Phone">মোবাইল নম্বর</label>
            <input asp-for="Phone" placeholder="01XXXXXXXXX" />
            <span asp-validation-for="Phone" class="validation"></span>

            <label asp-for="Password">পাসওয়ার্ড</label>
            <input asp-for="Password" placeholder="পাসওয়ার্ড" />
            <span asp-validation-for="Password" class="validation"></span>

            <button class="btn-primary" type="submit">লগইন</button>
            <div style="text-align: right; margin-top: -4px; margin-bottom: 6px;">
                <a href="#" onclick="openForgotPasswordModal(event)" style="color: var(--primary); font-size: 13.5px; font-weight: 700; text-decoration: none;">🔑 পাসওয়ার্ড ভুলে গেছেন?</a>
            </div>
            <a class="btn-light" asp-action="Register">নতুন ক্রেতা অ্যাকাউন্ট খুলুন</a>
            <small class="login-persistence-note">এই ব্রাউজারে ৩০ দিন লগইন মনে রাখা হবে। লগআউট করলে সংরক্ষিত লগইন মুছে যাবে।</small>
        </form>
    </section>
</main>

<div id="forgotPasswordModal" style="display:none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); z-index: 999; justify-content: center; align-items: center;">
    <div style="background: rgba(255, 255, 255, 0.98); padding: 28px; border-radius: var(--radius-xl); width: min(420px, 92%); border: 1px solid var(--border); box-shadow: 0 24px 60px rgba(15, 23, 42, 0.25);">
        <h3 style="margin-top:0; color: var(--text-primary); font-size: 20px; font-weight: 800;">🔑 পাসওয়ার্ড রিসেট</h3>
        <p style="font-size: 13.5px; color: var(--text-secondary); margin-bottom: 18px;">আপনার অ্যাকাউন্টের ১১ সংখ্যার মোবাইল নম্বর দিন। আমরা একটি OTP কোড পাঠাব।</p>
        <div id="forgotMsg" style="display:none; padding: 12px; border-radius: var(--radius-md); font-weight: 700; font-size: 13.5px; margin-bottom: 14px;"></div>

        <div id="step1">
            <label style="display:block; font-weight:700; font-size:13.5px; margin-bottom:6px; color: var(--text-primary);">মোবাইল নম্বর</label>
            <input type="tel" id="resetPhone" placeholder="01XXXXXXXXX" style="width: 100%; height: 48px; padding: 0 14px; border: 1px solid var(--border); border-radius: var(--radius-md); margin-bottom: 16px; font-size: 14px; outline: none; box-sizing: border-box;" />
            <div style="display: flex; gap: 10px; justify-content: flex-end;">
                <button type="button" onclick="closeForgotPasswordModal()" class="btn-light" style="min-height: 42px; padding: 0 16px;">বাতিল</button>
                <button type="button" onclick="sendResetOtp()" class="btn-primary" style="min-height: 42px; padding: 0 18px;">OTP পাঠান</button>
            </div>
        </div>

        <div id="step2" style="display:none;">
            <label style="display:block; font-weight:700; font-size:13.5px; margin-bottom:6px; color: var(--text-primary);">OTP কোড</label>
            <input type="text" id="resetOtp" placeholder="৬ সংখ্যার OTP" style="width: 100%; height: 48px; padding: 0 14px; border: 1px solid var(--border); border-radius: var(--radius-md); margin-bottom: 12px; font-size: 14px; outline: none; box-sizing: border-box;" />
            <label style="display:block; font-weight:700; font-size:13.5px; margin-bottom:6px; color: var(--text-primary);">নতুন পাসওয়ার্ড</label>
            <input type="password" id="resetNewPassword" placeholder="নতুন পাসওয়ার্ড" style="width: 100%; height: 48px; padding: 0 14px; border: 1px solid var(--border); border-radius: var(--radius-md); margin-bottom: 16px; font-size: 14px; outline: none; box-sizing: border-box;" />
            <div style="display: flex; gap: 10px; justify-content: flex-end;">
                <button type="button" onclick="closeForgotPasswordModal()" class="btn-light" style="min-height: 42px; padding: 0 16px;">বাতিল</button>
                <button type="button" onclick="submitPasswordReset()" class="btn-primary" style="min-height: 42px; padding: 0 18px;">পাসওয়ার্ড পরিবর্তন করুন</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function openForgotPasswordModal(e) {
            e.preventDefault();
            document.getElementById('forgotPasswordModal').style.display = 'flex';
        }
        function closeForgotPasswordModal() {
            document.getElementById('forgotPasswordModal').style.display = 'none';
        }
        async function sendResetOtp() {
            const phone = document.getElementById('resetPhone').value.trim();
            const msg = document.getElementById('forgotMsg');
            msg.style.display = 'none';

            const res = await fetch('/Account/RequestPasswordResetOtp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ Phone: phone })
            });
            const data = await res.json();
            msg.style.display = 'block';
            msg.style.background = data.success ? '#dcfce7' : '#fee2e2';
            msg.style.color = data.success ? '#166534' : '#991b1b';
            msg.textContent = data.message;

            if (data.success) {
                document.getElementById('step1').style.display = 'none';
                document.getElementById('step2').style.display = 'block';
            }
        }
        async function submitPasswordReset() {
            const phone = document.getElementById('resetPhone').value.trim();
            const otp = document.getElementById('resetOtp').value.trim();
            const newPassword = document.getElementById('resetNewPassword').value.trim();
            const msg = document.getElementById('forgotMsg');

            const res = await fetch('/Account/ResetPasswordWithOtp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ Phone: phone, Otp: otp, NewPassword: newPassword })
            });
            const data = await res.json();
            msg.style.display = 'block';
            msg.style.background = data.success ? '#dcfce7' : '#fee2e2';
            msg.style.color = data.success ? '#166534' : '#991b1b';
            msg.textContent = data.message;

            if (data.success) {
                setTimeout(closeForgotPasswordModal, 2500);
            }
        }
    </script>
}
