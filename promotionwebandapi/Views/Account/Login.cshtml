@model LoginViewModel
@{
    ViewData["Title"] = "লগইন";
}

<main class="auth-page">
    <section class="auth-card">
        <a class="brand compact" asp-controller="Home" asp-action="Index">
            <img src="~/images/amar_thikanaa_icon.png" alt="" />
            <span><strong>আমার ঠিকানা</strong><small>সব ধরনের অ্যাকাউন্টে লগইন</small></span>
        </a>
        <h1>লগইন করুন</h1>
        <p>মোবাইল নম্বর ও পাসওয়ার্ড দিয়ে আপনার অ্যাকাউন্টে প্রবেশ করুন।</p>

        <form asp-action="Login" method="post" class="form-stack">
            <div asp-validation-summary="ModelOnly" class="validation"></div>

            <label asp-for="Phone">মোবাইল নম্বর</label>
            <input asp-for="Phone" placeholder="01XXXXXXXXX" />
            <span asp-validation-for="Phone" class="validation"></span>

            <label asp-for="Password">পাসওয়ার্ড</label>
            <input asp-for="Password" placeholder="পাসওয়ার্ড" />
            <span asp-validation-for="Password" class="validation"></span>

            <button class="btn-primary" type="submit">লগইন</button>
            <div style="text-align: right; margin-top: -6px; margin-bottom: 10px;">
                <a href="#" onclick="openForgotPasswordModal(event)" style="color: #2563eb; font-size: 13px; font-weight: bold; text-decoration: none;">🔑 পাসওয়ার্ড ভুলে গেছেন?</a>
            </div>
            <a class="btn-light" asp-action="Register">নতুন ক্রেতা অ্যাকাউন্ট খুলুন</a>
            <small class="login-persistence-note">এই ব্রাউজারে ৩০ দিন লগইন মনে রাখা হবে। লগআউট করলে সংরক্ষিত লগইন মুছে যাবে।</small>
        </form>
    </section>
</main>

<div id="forgotPasswordModal" style="display:none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 999; justify-content: center; align-items: center;">
    <div style="background: #fff; padding: 24px; border-radius: 16px; width: min(400px, 90%); box-shadow: 0 20px 40px rgba(0,0,0,0.2);">
        <h3 style="margin-top:0; color: #1e3a8a;">🔑 পাসওয়ার্ড রিসেট</h3>
        <p style="font-size: 13px; color: #64748b;">আপনার অ্যাকাউন্টের ১১ সংখ্যার মোবাইল নম্বর দিন। আমরা একটি OTP কোড পাঠাব।</p>
        <div id="forgotMsg" style="display:none; padding: 10px; border-radius: 8px; font-weight: bold; font-size: 13px; margin-bottom: 12px;"></div>

        <div id="step1">
            <label style="display:block; font-weight:bold; font-size:13px; margin-bottom:4px;">মোবাইল নম্বর</label>
            <input type="tel" id="resetPhone" placeholder="01XXXXXXXXX" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 8px; margin-bottom: 14px;" />
            <div style="display: flex; gap: 8px; justify-content: flex-end;">
                <button type="button" onclick="closeForgotPasswordModal()" style="padding: 8px 16px; border: 0; background: #e2e8f0; border-radius: 8px; cursor: pointer;">বাতিল</button>
                <button type="button" onclick="sendResetOtp()" style="padding: 8px 16px; border: 0; background: #2563eb; color: #fff; border-radius: 8px; font-weight: bold; cursor: pointer;">OTP পাঠান</button>
            </div>
        </div>

        <div id="step2" style="display:none;">
            <label style="display:block; font-weight:bold; font-size:13px; margin-bottom:4px;">OTP কোড</label>
            <input type="text" id="resetOtp" placeholder="৬ সংখ্যার OTP" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 8px; margin-bottom: 10px;" />
            <label style="display:block; font-weight:bold; font-size:13px; margin-bottom:4px;">নতুন পাসওয়ার্ড</label>
            <input type="password" id="resetNewPassword" placeholder="নতুন পাসওয়ার্ড" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 8px; margin-bottom: 14px;" />
            <div style="display: flex; gap: 8px; justify-content: flex-end;">
                <button type="button" onclick="closeForgotPasswordModal()" style="padding: 8px 16px; border: 0; background: #e2e8f0; border-radius: 8px; cursor: pointer;">বাতিল</button>
                <button type="button" onclick="submitPasswordReset()" style="padding: 8px 16px; border: 0; background: #059669; color: #fff; border-radius: 8px; font-weight: bold; cursor: pointer;">পাসওয়ার্ড পরিবর্তন করুন</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function openForgotPasswordModal(e) {
            e.preventDefault();
            document.getElementById('forgotPasswordModal').style.display = 'flex';
        }
        function closeForgotPasswordModal() {
            document.getElementById('forgotPasswordModal').style.display = 'none';
        }
        async function sendResetOtp() {
            const phone = document.getElementById('resetPhone').value.trim();
            const msg = document.getElementById('forgotMsg');
            msg.style.display = 'none';

            const res = await fetch('/Account/RequestPasswordResetOtp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ Phone: phone })
            });
            const data = await res.json();
            msg.style.display = 'block';
            msg.style.background = data.success ? '#dcfce7' : '#fee2e2';
            msg.style.color = data.success ? '#166534' : '#991b1b';
            msg.textContent = data.message;

            if (data.success) {
                document.getElementById('step1').style.display = 'none';
                document.getElementById('step2').style.display = 'block';
            }
        }
        async function submitPasswordReset() {
            const phone = document.getElementById('resetPhone').value.trim();
            const otp = document.getElementById('resetOtp').value.trim();
            const newPassword = document.getElementById('resetNewPassword').value.trim();
            const msg = document.getElementById('forgotMsg');

            const res = await fetch('/Account/ResetPasswordWithOtp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ Phone: phone, Otp: otp, NewPassword: newPassword })
            });
            const data = await res.json();
            msg.style.display = 'block';
            msg.style.background = data.success ? '#dcfce7' : '#fee2e2';
            msg.style.color = data.success ? '#166534' : '#991b1b';
            msg.textContent = data.message;

            if (data.success) {
                setTimeout(closeForgotPasswordModal, 2500);
            }
        }
    </script>
}
