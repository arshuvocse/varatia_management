                            @foreach (var p in varatia.SslCommerzPayments)
                            {
                                var isSuccess = p.Status.Equals("success", StringComparison.OrdinalIgnoreCase);
                                var isPending = p.Status.Equals("pending", StringComparison.OrdinalIgnoreCase);
                                var isReg = p.PaymentType.Contains("রেজিস্ট্রেশন");

                                <tr>
                                    <td>
                                        <code style="font-weight: 700; font-size: 12px; color: #0369a1;">@p.TransactionId</code>
                                    </td>
                                    <td><strong>@p.UserName</strong></td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(p.UserPhone))
                                        {
                                            <a href="tel:@p.UserPhone" class="text-decoration-none">
                                                <i class="bi bi-telephone"></i> @p.UserPhone
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (string.Equals(p.UserRole, "owner", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge" style="background: #e0e7ff; color: #4338ca;">বাড়িওয়ালা</span>
                                        }
                                        else if (string.Equals(p.UserRole, "tenant", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge" style="background: #ecfdf5; color: #047857;">ভাড়াটিয়া</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border">@(string.IsNullOrWhiteSpace(p.UserRole) ? "User" : p.UserRole)</span>
                                        }
                                    </td>
                                    <td>
                                        @if (isReg)
                                        {
                                            <span class="badge" style="background: #e0e7ff; color: #1e40af; font-size: 12px;">🌟 @p.PaymentType</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border">@p.PaymentType</span>
                                        }
                                    </td>
                                    <td>
                                        <strong style="color: #059669; font-size: 15px;">৳ @p.Amount.ToString("N2")</strong>
                                    </td>
                                    <td>
                                        <span class="badge" style="background: #f1f5f9; color: #334155;">@p.Gateway</span>
                                    </td>
                                    <td>
                                        @if (isSuccess)
                                        {
                                            <span class="badge bg-success">✓ সফল (Success)</span>
                                        }
                                        else if (isPending)
                                        {
                                            <span class="badge bg-warning text-dark">⏳ পেন্ডিং (Pending)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">✕ @p.Status</span>
                                        }
                                    </td>
                                    <td>
                                        <small class="text-muted">
