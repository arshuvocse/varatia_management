@model CompanyDashboardViewModel
@{
    Layout = "_CompanyLayout";
    ViewData["Title"] = "জেলা মূল্য ও ক্যাটাগরি";
    ViewData["PageTitle"] = "জেলাভিত্তিক মূল্য নির্ধারণ ও শপ ক্যাটাগরি";
    ViewData["ActivePage"] = "PlatformSettings";
    var settings = ViewBag.PlatformSettings as PlatformSettingsViewModel ?? new PlatformSettingsViewModel();
}

<style>
    .settings-section { background: #fff; border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 22px 24px; margin-bottom: 24px; box-shadow: var(--shadow-card); }
    .settings-section h3 { margin: 0 0 6px; font-size: 18px; font-weight: 800; color: var(--text-primary); }
    .settings-section p.hint { margin: 0 0 16px; font-size: 13px; color: var(--text-muted); line-height: 1.5; }
    .settings-table-wrap { overflow-x: auto; }
    .settings-table { width: 100%; border-collapse: collapse; text-align: left; font-size: 13.5px; }
    .settings-table th { background: var(--bg-sidebar); color: var(--text-muted); font-weight: 700; padding: 12px 14px; border-bottom: 1px solid var(--border); white-space: nowrap; font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.05em; }
    .settings-table td { padding: 10px 12px; border-bottom: 1px solid #f1f5f9; vertical-align: middle; color: var(--text-primary); }
    .settings-table tr:hover td { background: rgba(79, 70, 229, 0.02); }
    .settings-table input[type="number"], .settings-table input[type="text"] { width: 95px; padding: 7px 10px; border: 1px solid var(--border); border-radius: var(--radius-md); font-size: 13px; outline: none; transition: all 0.2s; }
    .settings-table input[type="text"].wide { width: 150px; }
    .settings-table input:focus { border-color: var(--border-focus); box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15); }
    .settings-table td.actions-cell { white-space: nowrap; }
    .add-row-form { margin-top: 18px; border-top: 1px dashed var(--border); padding-top: 16px; }
    .add-row-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; align-items: end; }
    .add-row-grid label { display: grid; gap: 5px; font-size: 12.5px; font-weight: 700; color: var(--text-secondary); }
    .add-row-grid input { padding: 8px 12px; border: 1px solid var(--border); border-radius: var(--radius-md); font-size: 13.5px; outline: none; }
    .add-row-grid input:focus { border-color: var(--border-focus); box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15); }
    .btn-save-row { padding: 7px 14px; font-size: 12px; font-weight: 700; background: var(--primary); color: #fff; border: none; border-radius: var(--radius-md); cursor: pointer; transition: all 0.2s; }
    .btn-save-row:hover { background: var(--primary-hover); }
    .inactive-chip { background: var(--error-bg); color: var(--error); border: 1px solid var(--error-border); padding: 3px 10px; border-radius: var(--radius-pill); font-size: 11px; font-weight: 700; }
</style>

@if (!string.IsNullOrWhiteSpace(settings.SuccessMessage))
{
    <div class="alert-success">@settings.SuccessMessage</div>
}
@if (!string.IsNullOrWhiteSpace(settings.ErrorMessage))
{
    <div class="validation-summary-errors">@settings.ErrorMessage</div>
}

<section class="settings-section">
    <h3>জেলাভিত্তিক মূল্য কনফিগারেশন</h3>
    <p class="hint">প্রতিটি জেলার জন্য District Adjustment, Delivery/Service/Platform Charge এবং Company/Shopkeeper Margin % এখান থেকে সরাসরি পরিবর্তন করা যাবে — এই মানগুলোই Customer checkout-এর Final Price নির্ধারণ করে।</p>
    <div class="settings-table-wrap">
        <table class="settings-table">
            <thead>
                <tr>
                    <th>জেলা</th>
                    <th>District Adj (৳)</th>
                    <th>Delivery (৳)</th>
                    <th>Service (৳)</th>
                    <th>Platform (৳)</th>
                    <th>Shopkeeper %</th>
                    <th>Company %</th>
                    <th>সক্রিয়</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in settings.DistrictPricing)
                {
                    <tr>
                        <form asp-action="UpdateDistrictPricing" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="Id" value="@row.Id" />
                            <td><strong>@row.DistrictName</strong>@if (!row.IsActive) { <span class="inactive-chip">নিষ্ক্রিয়</span> }</td>
                            <td><input type="number" name="DistrictAdjustmentAmount" min="0" step="0.01" value="@row.DistrictAdjustmentAmount" required /></td>
                            <td><input type="number" name="DefaultDeliveryCharge" min="0" step="0.01" value="@row.DefaultDeliveryCharge" required /></td>
                            <td><input type="number" name="ServiceCharge" min="0" step="0.01" value="@row.ServiceCharge" required /></td>
                            <td><input type="number" name="PlatformCharge" min="0" step="0.01" value="@row.PlatformCharge" required /></td>
                            <td><input type="number" name="ShopkeeperMarginPercent" min="0" max="100" step="0.01" value="@row.ShopkeeperMarginPercent" required /></td>
                            <td><input type="number" name="CompanyMarginPercent" min="0" max="100" step="0.01" value="@row.CompanyMarginPercent" required /></td>
                            <td><input type="checkbox" name="IsActive" value="true" checked="@row.IsActive" /></td>
                            <td class="actions-cell"><button type="submit" class="btn-save-row">সংরক্ষণ</button></td>
                        </form>
                    </tr>
                }
                @if (settings.DistrictPricing.Count == 0)
                {
                    <tr><td colspan="9" style="text-align:center; padding:20px; color:#64748b;">কোনো জেলা কনফিগারেশন পাওয়া যায়নি।</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="add-row-form">
        <strong style="font-size: 13px; color: #0f172a;">নতুন জেলা যোগ করুন</strong>
        <form asp-action="AddDistrictPricing" method="post" style="margin-top: 10px;">
            @Html.AntiForgeryToken()
            <div class="add-row-grid">
                <label>জেলার নাম (ইংরেজি)<input type="text" name="DistrictName" placeholder="যেমন Pabna" required /></label>
                <label>District Adj (৳)<input type="number" name="DistrictAdjustmentAmount" min="0" step="0.01" value="0" required /></label>
                <label>Delivery (৳)<input type="number" name="DefaultDeliveryCharge" min="0" step="0.01" value="40" required /></label>
                <label>Service (৳)<input type="number" name="ServiceCharge" min="0" step="0.01" value="10" required /></label>
                <label>Platform (৳)<input type="number" name="PlatformCharge" min="0" step="0.01" value="5" required /></label>
                <label>Shopkeeper %<input type="number" name="ShopkeeperMarginPercent" min="0" max="100" step="0.01" value="10" required /></label>
                <label>Company %<input type="number" name="CompanyMarginPercent" min="0" max="100" step="0.01" value="5" required /></label>
                <button type="submit" class="btn-primary" style="padding: 8px 16px; font-size: 13px;">যোগ করুন</button>
            </div>
        </form>
    </div>
</section>

<section class="settings-section">
    <h3>শপ ক্যাটাগরি ব্যবস্থাপনা</h3>
    <p class="hint">ক্যাটাগরির বাংলা নাম, আইকন, বিবরণ ও ক্রম পরিবর্তন করুন, অথবা নতুন ব্যবসায়িক ক্যাটাগরি যোগ করুন।</p>
    <div class="settings-table-wrap">
        <table class="settings-table">
            <thead>
                <tr>
                    <th>নাম (কী)</th>
                    <th>বাংলা নাম</th>
                    <th>আইকন</th>
                    <th>বিবরণ</th>
                    <th>ক্রম</th>
                    <th>পণ্য সংখ্যা</th>
                    <th>সক্রিয়</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cat in settings.ShopCategories)
                {
                    <tr>
                        <form asp-action="UpdateShopCategory" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="Id" value="@cat.Id" />
                            <td><strong>@cat.Name</strong></td>
                            <td><input type="text" class="wide" name="BanglaName" value="@cat.BanglaName" required /></td>
                            <td><input type="text" name="Icon" value="@cat.Icon" required style="width: 50px;" /></td>
                            <td><input type="text" class="wide" name="Description" value="@cat.Description" /></td>
                            <td><input type="number" name="DisplayOrder" min="0" step="1" value="@cat.DisplayOrder" style="width: 60px;" required /></td>
                            <td>@cat.ProductCount</td>
                            <td><input type="checkbox" name="IsActive" value="true" checked="@cat.IsActive" /></td>
                            <td class="actions-cell"><button type="submit" class="btn-save-row">সংরক্ষণ</button></td>
                        </form>
                    </tr>
                }
                @if (settings.ShopCategories.Count == 0)
                {
                    <tr><td colspan="8" style="text-align:center; padding:20px; color:#64748b;">কোনো ক্যাটাগরি পাওয়া যায়নি।</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="add-row-form">
        <strong style="font-size: 13px; color: #0f172a;">নতুন ক্যাটাগরি যোগ করুন</strong>
        <form asp-action="AddShopCategory" method="post" style="margin-top: 10px;">
            @Html.AntiForgeryToken()
            <div class="add-row-grid">
                <label>নাম (Key, ইউনিক)<input type="text" name="Name" placeholder="যেমন হার্ডওয়্যার দোকান" required /></label>
                <label>বাংলা নাম<input type="text" name="BanglaName" placeholder="যেমন হার্ডওয়্যার" required /></label>
                <label>আইকন (Emoji)<input type="text" name="Icon" placeholder="🔧" required /></label>
                <label>বিবরণ<input type="text" name="Description" placeholder="ঐচ্ছিক" /></label>
                <label>ক্রম<input type="number" name="DisplayOrder" min="0" step="1" value="9" required /></label>
                <button type="submit" class="btn-primary" style="padding: 8px 16px; font-size: 13px;">যোগ করুন</button>
            </div>
        </form>
    </div>
</section>
