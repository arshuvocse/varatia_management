@model CompanyDashboardViewModel
@{
    Layout = "_CompanyLayout";
    ViewData["Title"] = "Promotions";
    ViewData["PageTitle"] = "Promotions";
    ViewData["ActivePage"] = "Campaigns";
}

<section class="company-section">
    <div class="company-section-heading"><div><span>প্রচার</span><h2>প্রচারের Conversion</h2></div></div>
    <div class="company-two-column">
        <div class="company-card">
            <div class="company-card-title"><h3>Campaigns</h3><span>@Model.ActiveCampaigns running</span></div>
            <div class="company-campaign-list">
                @foreach (var campaign in Model.Campaigns)
                {
                    var conversionRate = campaign.Clicks == 0 ? 0 : Math.Round(campaign.Conversions * 100m / campaign.Clicks, 1);
                    <article>
                        <div><strong>@campaign.Name</strong><small>@campaign.StartDate.ToString("dd MMM") - @campaign.EndDate.ToString("dd MMM yyyy")</small></div>
                        <span class="company-status">@campaign.Status</span>
                        <dl><div><dt>Reach</dt><dd>@campaign.Reach</dd></div><div><dt>Clicks</dt><dd>@campaign.Clicks</dd></div><div><dt>Conversion</dt><dd>@conversionRate%</dd></div><div><dt>Sale</dt><dd>&#2547; @campaign.SalesAmount.ToString("N0")</dd></div></dl>
                    </article>
                }
                @if (Model.Campaigns.Count == 0) { <p class="company-empty">এখনও কোনো প্রচার নেই। প্রথম প্রচার তৈরি করুন।</p> }
            </div>
        </div>
        <form class="company-card company-form" asp-action="CreateCampaign" method="post">
            <div class="company-card-title"><h3>প্রচার তৈরি করুন</h3></div>
            <label>নাম<input name="Name" required maxlength="150" placeholder="Eid cashback campaign" /></label>
            <label>শুরুর তারিখ<input name="StartDate" type="date" required value="@DateTime.Today.ToString("yyyy-MM-dd")" /></label>
            <label>শেষ তারিখ<input name="EndDate" type="date" required value="@DateTime.Today.AddDays(30).ToString("yyyy-MM-dd")" /></label>
            <button type="submit">প্রচার তৈরি করুন</button>
        </form>
    </div>
</section>
