@using System.Globalization
@model CompanyDashboardViewModel
@{
    var isFieldOfficer = Context.Session.GetString("UserRole") == Roles.FieldOfficer;
    Layout = isFieldOfficer ? "_Layout" : "_CompanyLayout";
    ViewData["Title"] = "Profit Distribution";
    ViewData["PageTitle"] = "Product Profit Distribution";
    ViewData["ActivePage"] = "ProductDistribution";
}

@if (isFieldOfficer)
{
    @Html.Raw("<main class=\"app-page shop-theme shop-portal-page officer-portal-page\"><div class=\"shop-portal-shell\">")
    <partial name="~/Views/FieldOfficer/_Sidebar.cshtml" model='new FieldOfficerDashboardViewModel { OfficerName = Model.CompanyName }' />
    @Html.Raw("<section class=\"shop-page-content\">")
    <header class="shop-page-header">
        <div>
            <span>FIELD FORCE APP</span>
            <h1>Profit distribution</h1>
            <p>Shopkeeper-wise purchase price and sales price margin theke earning split setup.</p>
        </div>
    </header>
    @if (TempData["CompanyMessage"] is string fieldMessage)
    {
        <div class="alert-success">@fieldMessage</div>
    }
    @if (TempData["CompanyError"] is string fieldError)
    {
        <div class="validation-summary-errors">@fieldError</div>
    }
}

<section class="company-section">
    <div class="company-section-heading">
        <div>
            <span>PROFIT SHARE</span>
            <h2>Profit distribution entry</h2>
        </div>
    </div>

    <form class="company-card company-form distribution-entry-form"
          asp-controller="Account"
          asp-action="SaveProductAllocation"
          method="post"
          id="distribution-entry-form">
        <label>
            Product
            <select name="ProductId" id="distribution-product" required>
                <option value="">Select product</option>
                @foreach (var product in Model.DistributionProducts)
                {
                    <option value="@product.Id"
                            data-total="100"
                            data-shopkeeper="@product.ShopkeeperPercentage.ToString("0.####", CultureInfo.InvariantCulture)"
                            data-company="@product.CompanyPercentage.ToString("0.####", CultureInfo.InvariantCulture)"
                            data-agent="@product.AgentPercentage.ToString("0.####", CultureInfo.InvariantCulture)"
                            data-field-force="@product.FieldForcePercentage.ToString("0.####", CultureInfo.InvariantCulture)"
                            data-customer="@product.CustomerPercentage.ToString("0.####", CultureInfo.InvariantCulture)">
                        @product.Name (@product.ProductCode)
                    </option>
                }
            </select>
        </label>
        <label>
            Total profit %
            <input id="distribution-total" name="TotalPercentage" type="number" min="100" max="100" step="0.0001" value="100" required />
        </label>
        <label>
            Shopkeeper %
            <input class="js-entry-share" name="ShopkeeperPercentage" type="number" min="0" step="0.0001" value="100" required />
        </label>
        <label>
            Company %
            <input class="js-entry-share" name="CompanyPercentage" type="number" min="0" step="0.0001" value="0" required />
        </label>
        <label>
            Agent %
            <input class="js-entry-share" name="AgentPercentage" type="number" min="0" step="0.0001" value="0" required />
        </label>
        <label>
            Field Force %
            <input class="js-entry-share" name="FieldForcePercentage" type="number" min="0" step="0.0001" value="0" required />
        </label>
        <label>
            Customer %
            <input class="js-entry-share" name="CustomerPercentage" type="number" min="0" step="0.0001" value="0" required />
        </label>
        <div class="distribution-entry-summary">
            <span>Allocated</span>
            <strong id="distribution-allocated">0%</strong>
        </div>
        <button id="distribution-entry-save" type="submit" disabled>Save profit distribution</button>
    </form>
</section>

<section class="company-section">
    <div class="company-section-heading">
        <div>
            <span>DISTRIBUTION SETUP</span>
            <h2>প্রফিট বণ্টন</h2>
        </div>
        <span>@Model.DistributionProducts.Count products</span>
    </div>

    <div class="company-card">
        <p class="distribution-help">
            Field Force shopkeeper অনুযায়ী purchase price ও sales price সেট করবে।
            Sale হলে profit = sales price - purchase price। Profit-er 100% Shopkeeper, Company, Agent, Field Force ও Customer-এর মধ্যে dynamic ভাগ হবে।
        </p>
        <div class="company-table-wrap">
            <table class="company-table product-allocation-table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Total profit %</th>
                        <th>Shopkeeper %</th>
                        <th>Company %</th>
                        <th>Agent %</th>
                        <th>Field Force %</th>
                        <th>Customer %</th>
                        <th>Allocated</th>
                        <th>Image</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var product in Model.DistributionProducts)
                {
                    var formId = $"allocation-{product.Id}";
                    var fallbackImage = product.Category switch
                    {
                        "মুদির দোকান" => "https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&fit=crop&w=900&q=80",
                        "ফার্মেসি" => "https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?auto=format&fit=crop&w=900&q=80",
                        "কসমেটিকস" => "https://images.unsplash.com/photo-1596462502278-27bfdc403348?auto=format&fit=crop&w=900&q=80",
                        "ইলেকট্রনিক্স" => "https://images.unsplash.com/photo-1498049794561-7780e7231661?auto=format&fit=crop&w=900&q=80",
                        _ => null
                    };
                    var imageUrl = string.IsNullOrWhiteSpace(product.ImageUrl) ? fallbackImage : product.ImageUrl;
                    <tr class="js-allocation-row" data-expected="100">
                        <td>
                            <strong>@product.Name</strong>
                            <small>@product.ProductCode · @product.Category</small>
                        </td>
                        <td><strong>100%</strong></td>
                        <td><input form="@formId" class="js-share" name="ShopkeeperPercentage" type="number" min="0" step="0.0001" value="@product.ShopkeeperPercentage.ToString("0.####", CultureInfo.InvariantCulture)" required /></td>
                        <td><input form="@formId" class="js-share" name="CompanyPercentage" type="number" min="0" step="0.0001" value="@product.CompanyPercentage.ToString("0.####", CultureInfo.InvariantCulture)" required /></td>
                        <td><input form="@formId" class="js-share" name="AgentPercentage" type="number" min="0" step="0.0001" value="@product.AgentPercentage.ToString("0.####", CultureInfo.InvariantCulture)" required /></td>
                        <td><input form="@formId" class="js-share" name="FieldForcePercentage" type="number" min="0" step="0.0001" value="@product.FieldForcePercentage.ToString("0.####", CultureInfo.InvariantCulture)" required /></td>
                        <td><input form="@formId" class="js-share" name="CustomerPercentage" type="number" min="0" step="0.0001" value="@product.CustomerPercentage.ToString("0.####", CultureInfo.InvariantCulture)" required /></td>
                        <td><strong class="js-allocated">@product.Percentage.ToString("0.####")%</strong></td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(imageUrl))
                            {
                                <img id="distPreview_@product.ProductCode" src="@imageUrl" alt="@product.Name" loading="lazy" style="width: 40px; height: 40px; object-fit: cover; display: block; margin-bottom: 4px; border-radius: 4px;" />
                            }
                            else
                            {
                                <img id="distPreview_@product.ProductCode" src="#" style="width: 40px; height: 40px; object-fit: cover; display: none; margin-bottom: 4px; border-radius: 4px;" />
                            }
                            <input form="@formId" name="ImageFile" type="file" accept="image/*" style="width: 130px; font-size: 11px;" onchange="previewCompanyImage(event, 'distPreview_@product.ProductCode')" />
                        </td>
                        <td>
                            <form id="@formId" asp-controller="Account" asp-action="SaveProductAllocation" method="post" enctype="multipart/form-data">
                                <input type="hidden" name="ProductId" value="@product.Id" />
                                <input type="hidden" name="TotalPercentage" value="100" />
                                <button class="company-table-action js-save-allocation" type="submit">Save</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.DistributionProducts.Count == 0)
                {
                    <tr><td colspan="10">No product has been added yet.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</section>

<script>
    const entryForm = document.getElementById("distribution-entry-form");
    const productSelect = document.getElementById("distribution-product");
    const totalInput = document.getElementById("distribution-total");
    const entryOutput = document.getElementById("distribution-allocated");
    const entryButton = document.getElementById("distribution-entry-save");
    const entryShares = entryForm.querySelectorAll(".js-entry-share");

    const roundPercentage = (value) => Math.round(value * 10000) / 10000;

    const constrainShares = (inputs, expected, changedInput = null) => {
        if (changedInput) {
            const allocatedByOthers = Array.from(inputs)
                .filter((input) => input !== changedInput)
                .reduce((total, input) => total + (Number(input.value) || 0), 0);
            const available = Math.max(0, roundPercentage(expected - allocatedByOthers));
            changedInput.max = available.toString();
            if ((Number(changedInput.value) || 0) > available) {
                changedInput.value = available.toString();
            }
        } else {
            let remaining = expected;
            inputs.forEach((input) => {
                const value = Math.min(Number(input.value) || 0, Math.max(0, remaining));
                input.value = roundPercentage(value).toString();
                remaining = roundPercentage(remaining - value);
            });
        }

        inputs.forEach((input) => {
            const allocatedByOthers = Array.from(inputs)
                .filter((other) => other !== input)
                .reduce((total, other) => total + (Number(other.value) || 0), 0);
            input.max = Math.max(0, roundPercentage(expected - allocatedByOthers)).toString();
        });
    };

    const updateEntry = (changedInput = null) => {
        const expected = Number(totalInput.value) || 0;
        constrainShares(entryShares, expected, changedInput);
        const allocated = roundPercentage(
            Array.from(entryShares)
                .reduce((total, input) => total + (Number(input.value) || 0), 0)
        );
        const matches = productSelect.value !== ""
            && Math.abs(allocated - expected) <= 0.0001;

        entryOutput.textContent = `${allocated.toFixed(4).replace(/\.?0+$/, "")}%`;
        entryOutput.classList.toggle("allocation-error", !matches);
        entryButton.disabled = !matches;
    };

    productSelect.addEventListener("change", () => {
        const option = productSelect.selectedOptions[0];
        totalInput.value = option?.dataset.total ?? "";
        entryShares[0].value = option?.dataset.shopkeeper ?? "100";
        entryShares[1].value = option?.dataset.company ?? "0";
        entryShares[2].value = option?.dataset.agent ?? "0";
        entryShares[3].value = option?.dataset.fieldForce ?? "0";
        entryShares[4].value = option?.dataset.customer ?? "0";
        updateEntry();
    });
    totalInput.addEventListener("input", () => updateEntry());
    entryShares.forEach((input) =>
        input.addEventListener("input", () => updateEntry(input)));

    document.querySelectorAll(".js-allocation-row").forEach((row) => {
        const expected = Number(row.dataset.expected);
        const output = row.querySelector(".js-allocated");
        const button = row.querySelector(".js-save-allocation");
        const inputs = row.querySelectorAll(".js-share");

        const update = (changedInput = null) => {
            constrainShares(inputs, expected, changedInput);
            const allocated = roundPercentage(
                Array.from(inputs)
                    .reduce((total, input) => total + (Number(input.value) || 0), 0)
            );
            const matches = Math.abs(allocated - expected) <= 0.0001;
            output.textContent = `${allocated.toFixed(4).replace(/\.?0+$/, "")}%`;
            output.classList.toggle("allocation-error", !matches);
            button.disabled = !matches;
        };

        inputs.forEach((input) =>
            input.addEventListener("input", () => update(input)));
        update();
    });

    function previewCompanyImage(event, imgId) {
        const file = event.target.files[0];
        const preview = document.getElementById(imgId);
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                preview.src = e.target.result;
                preview.style.display = 'block';
            }
            reader.readAsDataURL(file);
        } else {
            preview.src = '#';
            preview.style.display = 'none';
        }
    }
</script>

@if (isFieldOfficer)
{
    @Html.Raw("</section></div></main>")
}
