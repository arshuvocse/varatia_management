@model CompanyDashboardViewModel
@{
    Layout = "_CompanyLayout";
    ViewData["Title"] = "Support Team";
    ViewData["PageTitle"] = "Support Team Management";
    ViewData["ActivePage"] = "SupportAgents";
    var agents = ViewBag.SupportAgents as IReadOnlyList<PromotionWeb.Models.AppUser> ?? new List<PromotionWeb.Models.AppUser>();
}

<style>
    .support-agents-container {
        display: grid;
        grid-template-columns: 1fr 2fr;
        gap: 20px;
    }
    .form-panel, .agents-panel {
        background: #fff;
        padding: 24px;
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-card);
        border: 1px solid var(--border);
    }
    .form-group {
        margin-bottom: 16px;
    }
    .form-group label {
        display: block;
        margin-bottom: 6px;
        font-weight: 700;
        font-size: 13.5px;
        color: var(--text-primary);
    }
    .form-group input {
        width: 100%;
        height: 48px;
        padding: 0 14px;
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        outline: none;
        font-size: 14px;
        transition: all 0.2s ease;
        box-sizing: border-box;
    }
    .form-group input:focus {
        border-color: var(--border-focus);
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
    }
    .btn-submit {
        background: var(--primary-gradient);
        color: white;
        border: none;
        height: 48px;
        border-radius: var(--radius-md);
        cursor: pointer;
        width: 100%;
        font-weight: 700;
        font-size: 15px;
        box-shadow: 0 4px 14px rgba(79, 70, 229, 0.25);
        transition: all 0.2s ease;
    }
    .btn-submit:hover {
        background: var(--primary-gradient-hover);
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(79, 70, 229, 0.35);
    }
    .agent-card {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 16px;
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        margin-bottom: 12px;
        transition: all 0.2s ease;
        background: #ffffff;
    }
    .agent-card:hover {
        background: var(--bg-secondary);
        border-color: rgba(79, 70, 229, 0.3);
        transform: translateY(-1px);
    }
    .agent-avatar {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        object-fit: cover;
        box-shadow: 0 2px 8px rgba(30, 41, 59, 0.08);
        border: 2px solid var(--border);
    }
    .agent-info h4 {
        margin: 0 0 4px 0;
        color: var(--text-primary);
        font-size: 15px;
        font-weight: 700;
    }
    .agent-info p {
        margin: 0;
        color: var(--text-muted);
        font-size: 13px;
    }
    .agent-actions { margin-left: auto; display: flex; align-items: center; gap: 10px; }
    .agent-status { padding: 4px 10px; border-radius: var(--radius-pill); font-size: 11.5px; font-weight: 700; }
    .agent-status.active { color: var(--success); background: var(--success-bg); border: 1px solid var(--success-border); }
    .agent-status.inactive { color: var(--error); background: var(--error-bg); border: 1px solid var(--error-border); }
    .btn-status { border: 1px solid var(--border); background: #fff; padding: 7px 12px; border-radius: var(--radius-md); cursor: pointer; font-size: 12px; font-weight: 700; color: var(--text-secondary); transition: all 0.2s; }
    .btn-status:hover { border-color: var(--border-focus); color: var(--primary); background: var(--bg-secondary); }
    .support-alert { margin-bottom: 16px; padding: 12px 16px; border-radius: var(--radius-md); font-weight: 700; font-size: 13.5px; }
    .support-alert.success { color: var(--success); background: var(--success-bg); border: 1px solid var(--success-border); }
    .support-alert.error { color: var(--error); background: var(--error-bg); border: 1px solid var(--error-border); }
</style>

<div class="company-section">
    <div class="company-section-heading">
        <div><span>LIVE</span><h2>Support Team Management</h2></div>
        <small>Add and manage live chat support agents</small>
    </div>

    @if (TempData["SupportAgentSuccess"] is string successMessage)
    {
        <div class="support-alert success">@successMessage</div>
    }
    @if (TempData["SupportAgentError"] is string errorMessage)
    {
        <div class="support-alert error">@errorMessage</div>
    }

    <div class="support-agents-container">
        <div class="form-panel">
            <h3>Add New Agent</h3>
            <form method="post" action="/Account/CreateSupportAgent" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label>Agent Name</label>
                    <input type="text" name="name" required placeholder="Enter full name" />
                </div>
                <div class="form-group">
                    <label>Phone Number</label>
                    <input type="text" name="phone" required placeholder="017..." pattern="^01\d{9}$" />
                </div>
                <div class="form-group">
                    <label>Password</label>
                    <input type="password" name="password" required placeholder="Enter password" />
                </div>
                <div class="form-group">
                    <label>Profile Picture</label>
                    <input type="file" name="photo" accept=".jpg,.jpeg,.png,.webp" />
                </div>
                <button type="submit" class="btn-submit">Create Agent</button>
            </form>
        </div>

        <div class="agents-panel">
            <h3>Existing Support Agents</h3>
            @if(agents.Count == 0)
            {
                <p style="color:#777;">No agents found. Add one from the form.</p>
            }
            @foreach (var agent in agents)
            {
                <div class="agent-card">
                    <img src="@(agent.ProfilePictureUrl ?? "/images/default-avatar.svg")" class="agent-avatar" alt="@agent.Name" />
                    <div class="agent-info">
                        <h4>@agent.Name</h4>
                        <p>@agent.Phone</p>
                    </div>
                    <div class="agent-actions">
                        <span class="agent-status @(agent.IsActive ? "active" : "inactive")">@(agent.IsActive ? "Active" : "Inactive")</span>
                        <form method="post" action="/Account/SetSupportAgentStatus">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="agentId" value="@agent.Id" />
                            <input type="hidden" name="isActive" value="@(!agent.IsActive ? "true" : "false")" />
                            <button type="submit" class="btn-status">@(agent.IsActive ? "Deactivate" : "Activate")</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
