@model CompanyDashboardViewModel
@{
    Layout = "_CompanyLayout";
    ViewData["Title"] = "Support Team";
    ViewData["PageTitle"] = "Support Team Management";
    ViewData["ActivePage"] = "SupportAgents";
    var agents = ViewBag.SupportAgents as IReadOnlyList<PromotionWeb.Models.AppUser> ?? new List<PromotionWeb.Models.AppUser>();
}

<style>
    .support-agents-container {
        display: grid;
        grid-template-columns: 1fr 2fr;
        gap: 20px;
    }
    .form-panel, .agents-panel {
        background: #fff;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }
    .form-group {
        margin-bottom: 15px;
    }
    .form-group label {
        display: block;
        margin-bottom: 5px;
        font-weight: 500;
        color: #333;
    }
    .form-group input {
        width: 100%;
        padding: 10px;
        border: 1px solid #ddd;
        border-radius: 8px;
        outline: none;
    }
    .form-group input:focus {
        border-color: #764ba2;
    }
    .btn-submit {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        padding: 12px 20px;
        border-radius: 8px;
        cursor: pointer;
        width: 100%;
        font-weight: bold;
        transition: 0.3s;
    }
    .btn-submit:hover {
        opacity: 0.9;
        transform: translateY(-2px);
    }
    .agent-card {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 15px;
        border: 1px solid #eee;
        border-radius: 12px;
        margin-bottom: 10px;
        transition: 0.3s;
    }
    .agent-card:hover {
        background: #f8fbff;
        border-color: #667eea;
    }
    .agent-avatar {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        object-fit: cover;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    .agent-info h4 {
        margin: 0 0 5px 0;
        color: #333;
    }
    .agent-info p {
        margin: 0;
        color: #777;
        font-size: 0.9rem;
    }
    .agent-actions { margin-left: auto; display: flex; align-items: center; gap: 10px; }
    .agent-status { padding: 4px 9px; border-radius: 999px; font-size: .78rem; font-weight: 700; }
    .agent-status.active { color: #047857; background: #d1fae5; }
    .agent-status.inactive { color: #b91c1c; background: #fee2e2; }
    .btn-status { border: 1px solid #d7dce5; background: #fff; padding: 7px 11px; border-radius: 8px; cursor: pointer; }
    .support-alert { margin-bottom: 16px; padding: 12px 14px; border-radius: 10px; }
    .support-alert.success { color: #047857; background: #d1fae5; }
    .support-alert.error { color: #b91c1c; background: #fee2e2; }
</style>

<div class="company-section">
    <div class="company-section-heading">
        <div><span>LIVE</span><h2>Support Team Management</h2></div>
        <small>Add and manage live chat support agents</small>
    </div>

    @if (TempData["SupportAgentSuccess"] is string successMessage)
    {
        <div class="support-alert success">@successMessage</div>
    }
    @if (TempData["SupportAgentError"] is string errorMessage)
    {
        <div class="support-alert error">@errorMessage</div>
    }

    <div class="support-agents-container">
        <div class="form-panel">
            <h3>Add New Agent</h3>
            <form method="post" action="/Account/CreateSupportAgent" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label>Agent Name</label>
                    <input type="text" name="name" required placeholder="Enter full name" />
                </div>
                <div class="form-group">
                    <label>Phone Number</label>
                    <input type="text" name="phone" required placeholder="017..." pattern="^01\d{9}$" />
                </div>
                <div class="form-group">
                    <label>Password</label>
                    <input type="password" name="password" required placeholder="Enter password" />
                </div>
                <div class="form-group">
                    <label>Profile Picture</label>
                    <input type="file" name="photo" accept=".jpg,.jpeg,.png,.webp" />
                </div>
                <button type="submit" class="btn-submit">Create Agent</button>
            </form>
        </div>

        <div class="agents-panel">
            <h3>Existing Support Agents</h3>
            @if(agents.Count == 0)
            {
                <p style="color:#777;">No agents found. Add one from the form.</p>
            }
            @foreach (var agent in agents)
            {
                <div class="agent-card">
                    <img src="@(agent.ProfilePictureUrl ?? "/images/default-avatar.png")" class="agent-avatar" alt="@agent.Name" />
                    <div class="agent-info">
                        <h4>@agent.Name</h4>
                        <p>@agent.Phone</p>
                    </div>
                    <div class="agent-actions">
                        <span class="agent-status @(agent.IsActive ? "active" : "inactive")">@(agent.IsActive ? "Active" : "Inactive")</span>
                        <form method="post" action="/Account/SetSupportAgentStatus">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="agentId" value="@agent.Id" />
                            <input type="hidden" name="isActive" value="@(!agent.IsActive ? "true" : "false")" />
                            <button type="submit" class="btn-status">@(agent.IsActive ? "Deactivate" : "Activate")</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
