@{
    ViewData["Title"] = "অর্ডার ট্র্যাকিং - Amar Thikanaa";
    var order = ViewBag.Order as PromotionWeb.Models.CustomerOrderMaster;
    var assignment = ViewBag.Assignment as PromotionWeb.Models.DeliveryAssignment;
    var errorMessage = ViewBag.ErrorMessage as string;
}

<div style="max-width: 840px; margin: 40px auto; padding: 24px; font-family: 'Anek Bangla', 'Inter', sans-serif;">
    <div style="text-align: center; margin-bottom: 32px;">
        <span style="color: var(--primary); font-weight: 800; font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase;">Real-Time Status</span>
        <h1 style="color: var(--text-primary); font-size: 32px; font-weight: 800; margin: 6px 0 8px; letter-spacing: -0.5px;">📦 অর্ডার ট্র্যাকিং</h1>
        <p style="color: var(--text-secondary); font-size: 15px; margin: 0;">আপনার Order ID এবং মোবাইল নম্বর দিয়ে রিয়েল-টাইম ডেলিভারি স্ট্যাটাস খুঁজুন</p>
    </div>

    <form method="get" action="/track-order" style="background: rgba(255, 255, 255, 0.95); padding: 28px; border-radius: var(--radius-xl); border: 1px solid var(--border); box-shadow: var(--shadow-card); margin-bottom: 30px; backdrop-filter: blur(12px);">
        <div style="display: grid; grid-template-columns: 1fr 1fr auto; gap: 14px; align-items: end;">
            <div>
                <label style="display: block; font-weight: 700; color: var(--text-primary); margin-bottom: 6px; font-size: 13.5px;">Order ID</label>
                <input type="number" name="orderId" placeholder="যেমন: 1024" required style="width: 100%; height: 48px; padding: 0 14px; border: 1px solid var(--border); border-radius: var(--radius-md); font-size: 14.5px; outline: none; box-sizing: border-box;" />
            </div>
            <div>
                <label style="display: block; font-weight: 700; color: var(--text-primary); margin-bottom: 6px; font-size: 13.5px;">মোবাইল নম্বর</label>
                <input type="tel" name="phone" placeholder="যেমন: 01XXXXXXXXX" required style="width: 100%; height: 48px; padding: 0 14px; border: 1px solid var(--border); border-radius: var(--radius-md); font-size: 14.5px; outline: none; box-sizing: border-box;" />
            </div>
            <button type="submit" class="btn-primary" style="height: 48px; padding: 0 24px;">খুঁজুন</button>
        </div>
    </form>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="company-alert error" style="text-align: center; margin-bottom: 24px;">
            ⚠️ @errorMessage
        </div>
    }

    @if (order != null)
    {
        <div style="background: rgba(255, 255, 255, 0.98); padding: 32px; border-radius: var(--radius-xl); box-shadow: var(--shadow-card); border: 1px solid var(--border);">
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-light); padding-bottom: 18px; margin-bottom: 22px;">
                <div>
                    <h2 style="margin: 0; font-size: 22px; font-weight: 800; color: var(--text-primary);">অর্ডার #@order.Id</h2>
                    <small style="color: var(--text-muted); font-size: 12.5px;">তারিখ: @order.OrderDate.ToString("dd MMM yyyy, hh:mm tt")</small>
                </div>
                <span class="company-status success" style="font-size: 13px; padding: 6px 14px;">@order.Status</span>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px; background: var(--bg-app); border: 1px solid var(--border); padding: 18px; border-radius: var(--radius-md);">
                <div><span style="color: var(--text-muted); font-size: 12.5px; display: block;">গ্রাহক</span><strong>@order.CustomerName</strong> <small style="color: var(--text-secondary);">( @order.CustomerPhone )</small></div>
                <div><span style="color: var(--text-muted); font-size: 12.5px; display: block;">দোকান</span><strong>@order.ShopkeeperName</strong></div>
                <div><span style="color: var(--text-muted); font-size: 12.5px; display: block;">মোট মূল্য</span><strong style="color: var(--primary); font-size: 18px;">৳ @order.TotalAmount.ToString("N2")</strong></div>
                <div><span style="color: var(--text-muted); font-size: 12.5px; display: block;">ডিসকাউন্ট</span><strong>৳ @order.DiscountAmount.ToString("N2")</strong></div>
            </div>

            @if (assignment != null)
            {
                <div style="background: var(--bg-secondary); border: 1px solid rgba(79, 70, 229, 0.2); padding: 20px; border-radius: var(--radius-lg); margin-bottom: 24px;">
                    <h3 style="margin: 0 0 12px; color: var(--primary); font-size: 16px; font-weight: 800;">🛵 ডেলিভারি ম্যান</h3>
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <strong style="font-size: 16px; color: var(--text-primary);">@assignment.DeliveryManName</strong><br />
                            <a href="tel:@assignment.DeliveryManPhone" style="color: var(--primary); text-decoration: underline; font-weight: 600;">📞 @assignment.DeliveryManPhone</a>
                        </div>
                        <span class="company-status warning">@assignment.Status</span>
                    </div>
                </div>
            }

            <h3 style="margin: 0 0 14px; font-size: 17px; font-weight: 800; color: var(--text-primary);">পণ্যের বিবরণ</h3>
            <div class="company-table-wrap">
                <table class="company-table">
                    <thead>
                        <tr>
                            <th>পণ্য</th>
                            <th>পরিমাণ</th>
                            <th>মূল্য</th>
                            <th>মোট</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in order.Details)
                        {
                            <tr>
                                <td><strong>@item.ProductName</strong></td>
                                <td>@item.Quantity</td>
                                <td>৳ @item.UnitPrice.ToString("N2")</td>
                                <td><strong>৳ @item.TotalPrice.ToString("N2")</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div style="text-align: right; margin-top: 22px; padding-top: 16px; border-top: 1px solid var(--border-light);">
                <span style="font-size: 15px; color: var(--text-secondary); margin-right: 12px;">সর্বমোট পরিশোধযোগ্য:</span>
                <strong style="font-size: 22px; color: var(--primary); font-weight: 800;">৳ @order.NetAmount.ToString("N2")</strong>
            </div>
        </div>
    }
</div>
