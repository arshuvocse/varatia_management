@model PromotionWeb.Models.LandingPageViewModel

@{
    ViewData["Title"] = "Landing";
    var featuredShops = Model.FeaturedShopkeepers.Take(50).ToList();
}

<header class="site-header landing-header">
    <nav class="navbar landing-navbar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <img src="~/images/amar_thikanaa_icon.png" alt="" />
            <span>
                <strong>SmartBazar</strong>
                <small>District wise smart shopping network</small>
            </span>
        </a>
        <button class="nav-toggle" type="button" aria-label="মেনু খুলুন">☰</button>
        <div class="nav-links">
            <a href="#districts">Districts</a>
            <a href="#shops">দোকানদার</a>
            <a href="#apps">Apps</a>
            <a class="nav-cta" asp-controller="Account" asp-action="Login">লগইন</a>
        </div>
    </nav>
</header>

<!-- Floating Contact / Support Widget -->
