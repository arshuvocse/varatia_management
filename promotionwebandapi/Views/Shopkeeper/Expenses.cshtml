@model ShopkeeperDashboardViewModel
@{
    ViewData["Title"] = "Expenses";
    ViewData["ActivePage"] = "Expenses";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.2/css/dataTables.dataTables.min.css" />
    <style>
        .expense-entry-panel {
            margin-bottom: 24px;
        }

        .expense-entry-panel h2,
        .expense-list-panel h2 {
            margin-bottom: 6px;
        }

        .expense-entry-panel .panel-copy {
            margin: 0 0 20px;
            color: #64748b;
        }

        .expense-entry-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 16px;
        }

        .expense-entry-grid .field-wide {
            grid-column: 1 / -1;
        }

        .expense-entry-grid label {
            display: block;
            margin-bottom: 7px;
            color: #334155;
            font-weight: 800;
        }

        .expense-entry-grid input,
        .expense-entry-grid select {
            width: 100%;
            min-height: 46px;
            padding: 10px 12px;
            border: 1px solid #cbd5e1;
            border-radius: 10px;
            background: #fff;
            color: #0f172a;
            font: inherit;
        }

        .expense-entry-grid input:focus,
        .expense-entry-grid select:focus {
            border-color: #1464e9;
            outline: none;
            box-shadow: 0 0 0 3px rgba(20, 100, 233, .12);
        }

        .field-ddl-group {
            display: flex;
            align-items: flex-end;
            gap: 8px;
        }

        .btn-add-type {
            min-height: 46px;
            padding: 0 16px;
            border: 0;
            border-radius: 10px;
            background: #1464e9;
            color: #fff;
            font-size: 20px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .btn-add-type:hover {
            background: #0b51c5;
        }

        .expense-submit {
            justify-self: start;
            min-width: 170px;
            padding: 12px 20px;
            border: 0;
            border-radius: 10px;
            background: #1464e9;
            color: #fff;
            font: inherit;
            font-weight: 800;
            cursor: pointer;
        }

        .expense-submit:disabled {
            cursor: wait;
            opacity: .65;
        }

        .expense-message {
            display: none;
            margin-top: 16px;
            padding: 12px 14px;
            border-radius: 10px;
            font-weight: 700;
        }

        .expense-message.success {
            display: block;
            background: #dcfce7;
            color: #166534;
        }

        .expense-message.error {
            display: block;
            background: #fee2e2;
            color: #991b1b;
        }

        .expense-table-wrap {
            overflow-x: auto;
        }

        #expensesTable {
            width: 100% !important;
        }

        #expensesTable th,
        #expensesTable td {
            white-space: nowrap;
        }

        /* Modal Styles */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(4px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            animation: fadeIn 0.2s ease;
        }

        .modal-card {
            background: #ffffff;
            border-radius: 16px;
            width: 90%;
            max-width: 450px;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            overflow: hidden;
            transform: scale(0.95);
            animation: scaleUp 0.2s ease forwards;
        }

        @@keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        @@keyframes scaleUp {
            to { transform: scale(1); }
        }

        .modal-header {
            padding: 16px 20px;
            border-bottom: 1px solid #e2e8f0;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .modal-header h3 {
            margin: 0;
            font-size: 18px;
            font-weight: 800;
            color: #0f172a;
        }

        .modal-close {
            border: 0;
            background: transparent;
            font-size: 24px;
            cursor: pointer;
            color: #94a3b8;
            line-height: 1;
        }

        .modal-close:hover {
            color: #0f172a;
        }

        .modal-body {
            padding: 20px;
        }

        .modal-field {
            margin-bottom: 16px;
        }

        .modal-field label {
            display: block;
            margin-bottom: 8px;
            font-weight: 800;
            color: #334155;
        }

        .modal-field input {
            width: 100%;
            min-height: 46px;
            padding: 10px 12px;
            border: 1px solid #cbd5e1;
            border-radius: 10px;
            background: #fff;
            color: #0f172a;
            font: inherit;
        }

        .modal-field input:focus {
            border-color: #1464e9;
            outline: none;
            box-shadow: 0 0 0 3px rgba(20, 100, 233, .12);
        }

        .modal-footer {
            padding: 16px 20px;
            background: #f8fafc;
            border-top: 1px solid #e2e8f0;
            display: flex;
            justify-content: flex-end;
            gap: 12px;
        }

        .modal-btn-cancel {
            padding: 10px 16px;
            border: 1px solid #cbd5e1;
            border-radius: 10px;
            background: #fff;
            color: #334155;
            font-weight: bold;
            cursor: pointer;
        }

        .modal-btn-cancel:hover {
            background: #f1f5f9;
        }

        .modal-btn-save {
            padding: 10px 16px;
            border: 0;
            border-radius: 10px;
            background: #1464e9;
            color: #fff;
            font-weight: bold;
            cursor: pointer;
        }

        .modal-btn-save:hover {
            background: #0b51c5;
        }

        .product-message {
            display: none;
            margin-top: 16px;
            padding: 12px 14px;
            border-radius: 10px;
            font-weight: 700;
        }

        .product-message.success {
            display: block;
            background: #dcfce7;
            color: #166534;
        }

        .product-message.error {
            display: block;
            background: #fee2e2;
            color: #991b1b;
        }

        @@media (max-width: 680px) {
            .expense-entry-grid {
                grid-template-columns: 1fr;
            }

            .expense-entry-grid .field-wide {
                grid-column: auto;
            }

            .expense-submit {
                width: 100%;
            }
        }
    </style>
}

<main class="app-page shop-theme shop-portal-page">
    <div class="shop-portal-shell">
        <partial name="_Sidebar" model="Model" />

        <section class="shop-page-content">
            <header class="shop-page-header">
                <div>
                    <span>আর্থিক হিসাব</span>
                    <h1>খরচ</h1>
                    <p>দোকানের খরচ, খরচের ধরন এবং ট্র্যাকিং পরিচালনা করুন।</p>
                </div>
                <span class="table-chip">@Model.Expenses.Count expenses</span>
            </header>

            <section class="panel expense-entry-panel">
                <h2>নতুন খরচ যোগ করুন</h2>
                <p class="panel-copy">খরচের তথ্য পূরণ করে Save Expense বাটনে Clicks করুন।</p>

                <form id="expenseForm">
                    @Html.AntiForgeryToken()

                    <div class="expense-entry-grid">
                        <div>
                            <label for="shopkeeperCode">Shopkeeper Code</label>
                            <input id="shopkeeperCode" type="text" value="@Model.Shop.ShopCode (@Model.Shop.OwnerName)" disabled />
                            <input id="shopkeeperId" name="ShopkeeperId" type="hidden" value="@Model.Shop.Id" />
                        </div>

                        <div>
                            <label for="expenseType">Expense Type *</label>
                            <div class="field-ddl-group">
                                <select id="expenseType" name="ExpenseTypeId" required style="flex: 1;">
                                    <option value="">নির্বাচন করুন</option>
                                    @foreach (var type in Model.ExpenseTypes)
                                    {
                                        <option value="@type.Id">@type.Name</option>
                                    }
                                </select>
                                <button type="button" class="btn-add-type" id="btnOpenModal" title="নতুন Expense Type যোগ করুন">＋</button>
                            </div>
                        </div>

                        <div>
                            <label for="expenseDate">Expense Date *</label>
                            <input id="expenseDate" name="ExpenseDate" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>

                        <div>
                            <label for="amount">Amount (টাকা) *</label>
                            <input id="amount" name="Amount" type="number" min="0.01" max="9999999999.99" step="0.01" placeholder="0.00" required />
                        </div>

                        <button class="expense-submit" type="submit">Save Expense</button>
                    </div>
                </form>

                <div id="formMessage" class="expense-message" role="alert"></div>
            </section>

            <section class="panel expense-list-panel">
                <h2>Expense List</h2>
                <div class="expense-table-wrap">
                    <table id="expensesTable" class="display">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Expense Type</th>
                                <th>তারিখ</th>
                                <th>টাকার পরিমাণ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var index = 0; index < Model.Expenses.Count; index++)
                            {
                                var exp = Model.Expenses[index];
                                <tr>
                                    <td>@(index + 1)</td>
                                    <td>@exp.ExpenseTypeName</td>
                                    <td>@exp.ExpenseDate.ToString("dd MMM yyyy")</td>
                                    <td data-order="@exp.Amount">৳ @exp.Amount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </section>
    </div>
</main>

<!-- Modal -->
<div id="typeModal" class="modal-overlay" style="display: none;">
    <div class="modal-card">
        <div class="modal-header">
            <h3>নতুন Expense Type যোগ করুন</h3>
            <button type="button" class="modal-close" id="btnCloseModal">×</button>
        </div>
        <div class="modal-body">
            <div class="modal-field">
                <label for="newTypeName">Expense Type-এর নাম *</label>
                <input type="text" id="newTypeName" placeholder="যেমন: Internet Bill" required />
            </div>
            <div id="modalMessage" class="product-message" role="alert"></div>
        </div>
        <div class="modal-footer">
            <button type="button" class="modal-btn-cancel" id="btnCancelModal">Cancelled</button>
            <button type="button" class="modal-btn-save" id="btnSaveType">Save Type</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/2.3.2/js/dataTables.min.js"></script>
    <script>
        $(function () {
            $('#expensesTable').DataTable({
                pageLength: 10,
                lengthMenu: [10, 25, 50, 100],
                order: [[2, 'desc']],
                columnDefs: [
                    { orderable: false, searchable: false, targets: 0 }
                ],
                language: {
                    search: 'খুঁজুন:',
                    lengthMenu: '_MENU_ টি দেখান',
                    info: '_TOTAL_ টি খরচের মধ্যে _START_ থেকে _END_',
                    infoEmpty: 'কোনো খরচ পাওয়া যায়নি',
                    zeroRecords: 'মিল আছে এমন কোনো খরচ পাওয়া যায়নি',
                    emptyTable: 'কোনো খরচ যোগ করা হয়নি',
                    paginate: {
                        first: 'প্রথম',
                        last: 'শেষ',
                        next: 'পরের',
                        previous: 'আগের'
                    }
                }
            });

            // Modal Triggering
            $('#btnOpenModal').on('click', function () {
                $('#typeModal').fadeIn(200);
                $('#newTypeName').focus();
            });

            $('#btnCloseModal, #btnCancelModal').on('click', function () {
                $('#typeModal').fadeOut(200);
                $('#modalMessage').hide();
                $('#newTypeName').val('');
            });

            // Close modal when clicking outside the card
            $('#typeModal').on('click', function (e) {
                if ($(e.target).hasClass('modal-overlay')) {
                    $('#typeModal').fadeOut(200);
                    $('#modalMessage').hide();
                    $('#newTypeName').val('');
                }
            });

            // Save Type Action
            $('#btnSaveType').on('click', function () {
                const name = $('#newTypeName').val().trim();
                if (!name) {
                    alert('Expense Type-এর নাম দিন।');
                    return;
                }

                const token = $('input[name="__RequestVerificationToken"]').val();
                const $btn = $(this);
                const $msg = $('#modalMessage');

                $msg.removeClass('success error').hide();
                $btn.prop('disabled', true).text('Saving...');

                $.ajax({
                    url: '@Url.Action("AddExpenseType", "Shopkeeper")',
                    method: 'POST',
                    contentType: 'application/json; charset=utf-8',
                    dataType: 'json',
                    headers: {
                        RequestVerificationToken: token
                    },
                    data: JSON.stringify({ name: name })
                })
                .done(function (result) {
                    $msg.addClass('success').text(result.message || 'Expense Type সফলভাবে যোগ করা হয়েছে।').show();
                    $('#newTypeName').val('');

                    // Reload the DDL with updated list
                    const $ddl = $('#expenseType');
                    $ddl.empty();
                    $ddl.append('<option value="">নির্বাচন করুন</option>');
                    
                    let newOptionVal = "";
                    result.types.forEach(function (type) {
                        $ddl.append($('<option>', {
                            value: type.id,
                            text: type.name
                        }));
                        if (type.name.toLowerCase() === name.toLowerCase()) {
                            newOptionVal = type.id;
                        }
                    });

                    // Select the newly added type
                    if (newOptionVal) {
                        $ddl.val(newOptionVal);
                    }

                    setTimeout(function () {
                        $('#typeModal').fadeOut(200);
                    }, 800);
                })
                .fail(function (xhr) {
                    let message = 'Expense Type যোগ করা যায়নি।';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        message = xhr.responseJSON.message;
                    }
                    $msg.addClass('error').text(message).show();
                })
                .always(function () {
                    $btn.prop('disabled', false).text('Save Type');
                });
            });

            // Submit main form
            $('#expenseForm').on('submit', function (event) {
                event.preventDefault();

                const $form = $(this);
                const $button = $form.find('button[type="submit"]');
                const $message = $('#formMessage');
                const token = $form.find('input[name="__RequestVerificationToken"]').val();
                
                const expense = {
                    expenseTypeId: Number($('#expenseType').val()),
                    amount: Number($('#amount').val()),
                    expenseDate: $('#expenseDate').val()
                };

                $message.removeClass('success error').hide();
                $button.prop('disabled', true).text('Saving...');

                $.ajax({
                    url: '@Url.Action("AddExpense", "Shopkeeper")',
                    method: 'POST',
                    contentType: 'application/json; charset=utf-8',
                    dataType: 'json',
                    headers: {
                        RequestVerificationToken: token
                    },
                    data: JSON.stringify(expense)
                })
                .done(function (result) {
                    $message.addClass('success').text(result.message || 'Expense সফলভাবে যোগ করা হয়েছে।').show();
                    $form[0].reset();
                    
                    // Reset date to today since form reset clears it
                    $('#expenseDate').val('@DateTime.Today.ToString("yyyy-MM-dd")');

                    window.setTimeout(function () {
                        window.location.reload();
                    }, 700);
                })
                .fail(function (xhr) {
                    let message = 'Expense যোগ করা যায়নি। আবার চেষ্টা করুন।';
                    if (xhr.status === 401) {
                        message = 'আপনার session শেষ হয়েছে। আবার login করুন।';
                    } else if (xhr.responseJSON && xhr.responseJSON.message) {
                        message = xhr.responseJSON.message;
                    }
                    $message.addClass('error').text(message).show();
                })
                .always(function () {
                    $button.prop('disabled', false).text('Save Expense');
                });
            });
        });
    </script>
}
