@model ShopkeeperDashboardViewModel
@{
    ViewData["Title"] = "Wallet";
    ViewData["ActivePage"] = "Wallet";
}
<main class="app-page shop-theme shop-portal-page">
    <div class="shop-portal-shell">
        <partial name="_Sidebar" model="Model" />
        <section class="shop-page-content">
            <header class="shop-page-header"><div><span>WALLET</span><h1>Shopkeeper Wallet</h1><p>Available balance এবং withdrawal status দেখুন।</p></div></header>
            <section class="wallet-page-card">
                <span>Current balance</span><strong>৳ @Model.WalletBalance.ToString("N2")</strong><small>@Model.Shop.ShopName · @Model.Shop.ShopCode</small>
            </section>
            <section class="wallet-page-grid">
                <article><span>Withdrawable</span><strong>৳ @Model.WalletWithdrawable.ToString("N2")</strong><small>এখন withdraw করা যাবে</small></article>
                <article><span>অপেক্ষমাণ</span><strong>৳ @Model.WalletPending.ToString("N2")</strong><small>Settlement-এর অপেক্ষায়</small></article>
            </section>
            <section class="panel wallet-action-panel">
                @if (TempData["WalletError"] != null)
                {
                    <div class="alert alert-danger" style="margin-bottom:1rem;color:red;">@TempData["WalletError"]</div>
                }
                @if (TempData["WalletSuccess"] != null)
                {
                    <div class="alert alert-success" style="margin-bottom:1rem;color:green;">@TempData["WalletSuccess"]</div>
                }

                <div style="display: flex; gap: 2rem;">
                    <div style="flex: 1;">
                        <h2>Withdraw Request</h2><p>Withdrawable balance থেকে একটি request পাঠান।</p>
                        <form id="withdrawForm" asp-action="RequestWithdrawal" method="post" style="display:flex; flex-direction:column; gap:0.5rem; margin-top:1rem;" onsubmit="return handleWithdrawalSubmit(event)">
                            <input type="number" id="wAmount" name="Amount" placeholder="Amount (৳)" min="10" step="0.01" required class="input-text" />
                            <select name="PaymentMethod" required class="input-text">
                                <option value="bKash">bKash</option>
                                <option value="Nagad">Nagad</option>
                                <option value="Rocket">Rocket</option>
                            </select>
                            <input type="tel" id="wAccount" name="AccountNumber" placeholder="01XXXXXXXXX" pattern="01[0-9]{9}" required class="input-text" />
                            <input type="hidden" id="wOtpVerified" name="OtpVerified" value="false" />
                            <button class="btn-primary" type="submit">🔒 Request Withdrawal (2FA)</button>
                        </form>
                    </div>
                    <div style="flex: 1; border-left: 1px solid var(--border); padding-left: 2rem;">
                        <h2>Add Balance (SSL Commerz)</h2><p>আপনার Wallet-এ ব্যালেন্স যোগ করুন।</p>
                        <form asp-controller="Shopkeeper" asp-action="AddWalletBalance" method="post" style="display:flex; flex-direction:column; gap:0.5rem; margin-top:1rem;">
                            <input type="number" name="Amount" placeholder="Amount (৳)" min="10" step="0.01" required class="input-text" />
                            <button class="btn-primary" type="submit">Add Funds (SSLCommerz)</button>
                        </form>
                    </div>
                </div>
            </section>

<div id="payoutOtpModal" style="display:none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); z-index: 999; justify-content: center; align-items: center;">
    <div style="background: var(--bg-card); padding: 24px; border-radius: var(--radius-lg); width: min(400px, 90%); text-align: center; border: 1px solid var(--border); box-shadow: var(--shadow-elevated);">
        <h3 style="margin-top:0; color: var(--primary);">🔒 2FA নিরাপত্তা যাচাই</h3>
        <p style="font-size: 13px; color: var(--text-muted); margin-bottom: 16px;">নিরাপত্তার স্বার্থে আপনার মোবাইলে পাঠানো ৬ সংখ্যার OTP কোডটি লিখুন। (Demo OTP: 889900)</p>
        <input type="text" id="payoutOtpInput" placeholder="৬ সংখ্যার OTP" style="width: 100%; padding: 12px; border: 1px solid var(--border); border-radius: var(--radius-sm); margin-bottom: 16px; text-align: center; font-size: 20px; font-weight: 700; letter-spacing: 6px; background: var(--bg-app); color: var(--text-primary); box-sizing: border-box;" />
        <div style="display: flex; gap: 10px; justify-content: center;">
            <button type="button" onclick="closePayoutModal()" style="padding: 10px 18px; border: 1px solid var(--border); background: var(--bg-app); color: var(--text-secondary); border-radius: var(--radius-sm); font-weight: 700; cursor: pointer;">বাতিল</button>
            <button type="button" onclick="confirmPayoutOtp()" style="padding: 10px 20px; border: 0; background: var(--primary-gradient); color: #fff; border-radius: var(--radius-sm); font-weight: 700; cursor: pointer; box-shadow: var(--shadow-subtle);">যাচাই করুন</button>
        </div>
    </div>
</div>

<script>
    let pendingWithdrawForm = null;
    function handleWithdrawalSubmit(e) {
        const isVerified = document.getElementById('wOtpVerified').value;
        if (isVerified === 'true') return true;

        e.preventDefault();
        pendingWithdrawForm = e.target;
        document.getElementById('payoutOtpModal').style.display = 'flex';
        return false;
    }
    function closePayoutModal() {
        document.getElementById('payoutOtpModal').style.display = 'none';
    }
    function confirmPayoutOtp() {
        const otp = document.getElementById('payoutOtpInput').value.trim();
        if (otp === '889900' || otp.length === 6) {
            document.getElementById('wOtpVerified').value = 'true';
            closePayoutModal();
            if (pendingWithdrawForm) pendingWithdrawForm.submit();
        } else {
            alert('ভুল OTP কোড! আবার চেষ্টা করুন।');
        }
    }
</script>

            <section class="panel">
                <h2>Withdrawal Requests</h2>
                <div class="table-container">
                    <table class="shop-table">
                        <thead><tr><th>তারিখ</th><th>মাধ্যম</th><th>অ্যাকাউন্ট</th><th>পরিমাণ</th><th>অবস্থা</th></tr></thead>
                        <tbody>
                        @if (Model.WithdrawalRequests.Count == 0)
                        {
                            <tr><td colspan="5" style="text-align:center; padding:2rem;">কোনো withdrawal request নেই।</td></tr>
                        }
                        else
                        {
                            @foreach (var request in Model.WithdrawalRequests)
                            {
                                <tr><td>@request.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</td><td>@request.PaymentMethod</td><td>@request.AccountNumber</td><td>৳ @request.Amount.ToString("N2")</td><td><span class="status-chip pending">@request.Status</span></td></tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="panel">
                <h2>Commission Deductions</h2>
                <div class="table-container">
                    <table class="shop-table">
                        <thead>
                            <tr>
                                <th>তারিখ</th>
                                <th>Invoice</th>
                                <th>Product</th>
                                <th style="text-align:right">Deducted Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.WalletDeductionLogs.Count == 0)
                            {
                                <tr>
                                    <td colspan="4" style="text-align:center; padding: 2rem;">কোনো deduction log পাওয়া যায়নি।</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var log in Model.WalletDeductionLogs)
                                {
                                    <tr>
                                        <td>@log.CreatedAt.ToString("MMM dd, yyyy h:mm tt")</td>
                                        <td>@log.InvoiceNo</td>
                                        <td>@log.ProductName</td>
                                        <td style="text-align:right; color: #dc3545;">-৳ @log.AmountDeducted.ToString("N2")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </section>
    </div>
</main>
