@section Scripts {
<script>
    function openOrderReviewModal() {
        document.getElementById('orderReviewModal').style.display = 'flex';
    }
    function closeOrderReviewModal() {
        document.getElementById('orderReviewModal').style.display = 'none';
    }

    function removeParsedItem(btn, price) {
        const card = btn.closest('.sb-parsed-item-card');
        if (card) {
            card.remove();
            recalcReviewTotals();
        }
    }

    function recalcReviewTotals() {
        const cards = document.querySelectorAll('.sb-parsed-item-card');
        document.getElementById('reviewItemCount').textContent = cards.length + ' টি আইটেম';
        let total = 0;
        cards.forEach(c => {
            const priceTxt = c.querySelector('.sb-item-price')?.textContent || '0';
            const price = Number(priceTxt.replace(/[^\d.]/g, '')) || 0;
            total += price;
        });
        document.getElementById('reviewTotalAmount').textContent = '৳ ' + total;
    }

    function enableEditMode() {
        alert('আপনি প্রতিটি পণ্যের নাম ও পরিমাণ সরাসরি এডিট করতে পারবেন।');
    }

    function confirmOrderAndShowInvoice() {
        closeOrderReviewModal();
        document.getElementById('invoiceProfitModal').style.display = 'flex';
    }
    function closeInvoiceProfitModal() {
        document.getElementById('invoiceProfitModal').style.display = 'none';
    }

    function startNewOrder() {
        closeInvoiceProfitModal();
        alert('নতুন অর্ডার তৈরির জন্য রেডি!');
    }

    function shareBillToWhatsapp() {
        const msg = encodeURIComponent("রহমান স্টোর থেকে আপনার অর্ডার বিল #SB2505261050 প্রস্তুত। মোট বিল: ৳ ১১০। ধন্যবাদ!");
        window.open(`https://wa.me/8801712998877?text=${msg}`, '_blank');
    }

    function downloadInvoicePdf() {
        alert('বিল PDF ডাউনলোড হচ্ছে...');
    }

    function triggerPhotoUpload() {
        alert('হাতে লেখা ফর্দের ছবি আপলোড করুন - AI অটো পণ্যের তালিকা তৈরি করে নেবে!');
    }

    function startVoiceRecord() {
        alert('ভয়েস রেকর্ড শুরু হয়েছে... মুখে পণ্যের নাম ও পরিমাণ বলুন।');
    }

    function triggerFileUpload() {
        alert('ফর্দ বা অর্ডার ফাইল নির্বাচন করুন।');
    }

    function sendMessage() {
        const input = document.getElementById('chatMessageInput');
        if (!input.value.trim()) return;
        alert('বার্তা পাঠানো হয়েছে: ' + input.value);
        input.value = '';
    }
</script>
}
