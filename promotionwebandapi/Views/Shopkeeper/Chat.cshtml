        gap: 8px;
    }

    .sb-chat-action-btn {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: #f1f5f9;
        border: none;
        color: #334155;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        text-decoration: none;
    }

    /* CHAT BODY */
    .sb-chat-body-container {
        padding: 16px 20px;
        display: flex;
        flex-direction: column;
        gap: 14px;
        min-height: 320px;
