@section Styles {
<style>
    /* ========================================================== */
    /* CHAT-TO-ORDER & 50/50 PROFIT SPLIT THEME                   */
    /* ========================================================== */
    :root {
        --sb-primary: #059669;
        --sb-primary-hover: #047857;
        --sb-dark: #0f172a;
        --sb-border: #e2e8f0;
        --sb-radius-sm: 8px;
        --sb-radius-md: 14px;
        --sb-radius-lg: 20px;
    }

    body {
        background-color: #f1f5f9;
        font-family: 'Anek Bangla', 'Inter', sans-serif;
        margin: 0;
        padding: 0;
    }

    .sb-shop-layout {
        display: flex;
        min-height: 100vh;
        width: 100%;
    }

    .sb-chat-main {
