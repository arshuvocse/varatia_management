        padding-bottom: 40px;
    }

    /* TOPBAR */
    .sb-chat-topbar {
        background: #ffffff;
        padding: 12px 20px;
        border-bottom: 1px solid var(--sb-border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: sticky;
        top: 0;
        z-index: 30;
    }

    .sb-chat-user-header {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .sb-chat-back-btn {
        color: #0f172a;
        display: flex;
        align-items: center;
        text-decoration: none;
    }

    .sb-chat-avatar-wrap {
        position: relative;
        width: 44px;
        height: 44px;
    }

    .sb-chat-user-img {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
    }

    .sb-chat-online-dot {
        position: absolute;
        bottom: 2px;
        right: 2px;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #10b981;
        border: 2px solid #ffffff;
    }

    .sb-chat-user-meta h2 {
        margin: 0;
        font-size: 16px;
        font-weight: 800;
        color: #0f172a;
    }

    .sb-chat-status-txt {
        font-size: 12px;
