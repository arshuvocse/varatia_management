@model ShopkeeperDashboardViewModel
@{
    ViewData["Title"] = "চ্যাট থেকে অর্ডার ও ৫০/৫০ লাভ বণ্টন - Smart Bazar";
    ViewData["ActivePage"] = "Chat";
}

<div class="sb-shop-layout">
    <!-- Desktop Sidebar -->
    <partial name="_Sidebar" model="Model" />

    <!-- Main Content -->
    <main class="sb-chat-main">
        <!-- Top Navigation Header -->
        <header class="sb-chat-topbar">
            <div class="sb-chat-user-header">
                <a href="/Shopkeeper/Dashboard" class="sb-chat-back-btn">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                </a>
                <div class="sb-chat-avatar-wrap">
                    <img src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=100&q=80" alt="রহিম উদ্দিন" class="sb-chat-user-img" />
                    <span class="sb-chat-online-dot"></span>
                </div>
                <div class="sb-chat-user-meta">
                    <h2 class="sb-chat-user-name">রহিম উদ্দিন</h2>
                    <span class="sb-chat-status-txt">● Online</span>
                </div>
            </div>

            <div class="sb-chat-header-actions">
                <a href="tel:01712998877" class="sb-chat-action-btn" title="Call Customer">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                </a>
                <button type="button" class="sb-chat-action-btn" title="Menu">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="5" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="12" cy="19" r="2"/></svg>
                </button>
            </div>
        </header>

        <!-- Chat Conversation Body -->
        <div class="sb-chat-body-container">
            <!-- Encryption Security Banner -->
            <div class="sb-chat-encryption-badge">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                <span><strong>এন্ড-টু-এন্ড এনক্রিপটেড চ্যাট</strong> - আপনার সব বার্তা নিরাপদে এনক্রিপটেড করা আছে।</span>
            </div>

            <div class="sb-chat-date-separator"><span>আজ</span></div>

            <!-- Message 1: Customer Grocery List Message -->
            <div class="sb-chat-msg-row sb-msg-incoming">
                <div class="sb-chat-bubble sb-bubble-incoming">
                    <p class="sb-msg-text">
                        ভাই, নিচের বাজারগুলো দিবেন -<br>
                        <strong>কাঁচামরিচ ২০ টাকা</strong><br>
                        <strong>হলুদ ১০ টাকা</strong><br>
                        <strong>লবণ ১০ টাকা</strong><br>
                        <strong>শিম ৫০ টাকা</strong><br>
                        <strong>আলু ২০ টাকা</strong>
                    </p>
                    <span class="sb-msg-time">10:30 AM <span class="sb-msg-seen">✓✓</span></span>
                </div>
            </div>

            <!-- Message 2: Shopkeeper Reply -->
            <div class="sb-chat-msg-row sb-msg-outgoing">
                <div class="sb-chat-bubble sb-bubble-outgoing">
                    <p class="sb-msg-text">ঠিক আছে ভাই, অর্ডার নিচ্ছি</p>
                    <span class="sb-msg-time">10:31 AM</span>
                </div>
            </div>

            <!-- Smart Conversion Button: "🛒 অর্ডার হিসেবে নিন" -->
            <div class="sb-chat-convert-btn-wrap">
                <button type="button" class="sb-btn-convert-order" onclick="openOrderReviewModal()">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                        <circle cx="9" cy="21" r="1"></circle>
                        <circle cx="20" cy="21" r="1"></circle>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                    </svg>
                    <span>অর্ডার হিসেবে নিন</span>
                </button>
            </div>
        </div>

        <!-- Chat Bottom Input & Media Bar -->
        <div class="sb-chat-bottom-input-bar">
            <!-- Media Quick Attachment Bar -->
            <div class="sb-chat-media-shortcuts">
                <button type="button" class="sb-media-shortcut-btn" onclick="triggerPhotoUpload()">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                    <span>ছবি (ফর্দ)</span>
                </button>

                <button type="button" class="sb-media-shortcut-btn" onclick="startVoiceRecord()">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
                    <span>ভয়েস</span>
                </button>

                <button type="button" class="sb-media-shortcut-btn" onclick="triggerFileUpload()">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
                    <span>ফাইল</span>
                </button>

                <button type="button" class="sb-media-shortcut-btn sb-btn-add">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="19" x2="19" y2="12"/></svg>
                </button>
            </div>

            <!-- Input Box -->
            <div class="sb-chat-input-controls-row">
                <button type="button" class="sb-emoji-btn">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
                </button>
                <input type="text" placeholder="মেসেজ লিখুন..." class="sb-chat-text-input" id="chatMessageInput" />
                <button type="button" class="sb-chat-mic-submit-btn" id="chatSubmitBtn" onclick="sendMessage()">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.2"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
                </button>
            </div>
        </div>

        <!-- 5-Step Workflow & Benefits Infographic Section -->
        <section class="sb-workflow-infographic-card">
            <h3 class="sb-wf-title">এভাবেই কাজ করবে</h3>
            <div class="sb-wf-steps-grid">
                <!-- Step 1 -->
                <div class="sb-wf-step">
                    <div class="sb-wf-step-badge">১</div>
                    <strong>কাস্টমার লিস্ট পাঠাবে</strong>
                    <p>চ্যাট, ছবি, এসএমএস বা মুখে বলে দিবে</p>
                    <div class="sb-wf-icons-row">
                        <span>💬</span><span>🖼️</span><span>📱</span><span>🎙️</span>
                    </div>
                </div>

                <!-- Arrow -->
                <div class="sb-wf-arrow">➔</div>

                <!-- Step 2 -->
                <div class="sb-wf-step">
                    <div class="sb-wf-step-badge">২</div>
                    <strong>অর্ডার হিসেবে নিন</strong>
                    <p>দোকানদার চ্যাট থেকে অর্ডার হিসেবে নেবেন</p>
                    <div class="sb-wf-preview-btn">🛒 অর্ডার হিসেবে নিন</div>
                </div>

                <!-- Arrow -->
                <div class="sb-wf-arrow">➔</div>

                <!-- Step 3 -->
                <div class="sb-wf-step">
                    <div class="sb-wf-step-badge">৩</div>
                    <strong>অর্ডার পর্যালোচনা</strong>
                    <p>পণ্যের তালিকা দেখাবে, প্রয়োজনে এডিট করবেন</p>
                    <div class="sb-wf-items-sample">
                        <span>🌶️ কাঁচামরিচ ৳২০</span>
                        <span>🟡 হলুদ ৳১০</span>
                    </div>
                </div>

                <!-- Arrow -->
                <div class="sb-wf-arrow">➔</div>

                <!-- Step 4 -->
                <div class="sb-wf-step">
                    <div class="sb-wf-step-badge">৪</div>
                    <strong>কনফার্ম অর্ডার</strong>
                    <p>কনফার্ম করলেই বিল এবং হিসাব তৈরি হবে</p>
                    <div class="sb-wf-confirm-sample">✔️ কনফার্ম করুন</div>
                </div>

                <!-- Arrow -->
                <div class="sb-wf-arrow">➔</div>

                <!-- Step 5 -->
                <div class="sb-wf-step">
                    <div class="sb-wf-step-badge">৫</div>
                    <strong>লাভ বণ্টন ও সম্পন্ন</strong>
                    <p>স্বয়ংক্রিয়ভাবে লাভ বণ্টন হবে ৫০% - ৫০%</p>
                    <div class="sb-wf-profit-pill">
                        <span>🏬 ৳১০</span> + <span>🛍️ ৳১০</span>
                    </div>
                </div>
            </div>

            <!-- Features Bar -->
            <div class="sb-wf-features-strip">
                <div class="sb-feat-item">
                    <span class="sb-feat-icon">⚡</span>
                    <div>
                        <strong>অতি দ্রুত অর্ডার</strong>
                        <small>কয়েক সেকেন্ডে অর্ডার সম্পন্ন</small>
                    </div>
                </div>

                <div class="sb-feat-item">
                    <span class="sb-feat-icon">🧮</span>
                    <div>
                        <strong>হিসাব সম্পূর্ণ স্বয়ংক্রিয়</strong>
                        <small>ভুলের কোনো সুযোগ নেই</small>
                    </div>
                </div>

                <div class="sb-feat-item">
                    <span class="sb-feat-icon">⚖️</span>
                    <div>
                        <strong>লাভ বণ্টন স্বচ্ছ</strong>
                        <small>৫০% আপনার, ৫০% কোম্পানির</small>
                    </div>
                </div>

                <div class="sb-feat-item">
                    <span class="sb-feat-icon">📄</span>
                    <div>
                        <strong>বিল প্রিন্ট ও শেয়ার</strong>
                        <small>PDF ডাউনলোড ও শেয়ার করা যায়</small>
                    </div>
                </div>
            </div>
        </section>
    </main>
</div>

<!-- ========================================================================= -->
<!-- MODAL 1: স্ক্রিন ২ - অর্ডার পর্যালোচনা (Order Review & Parsing Modal)      -->
<!-- ========================================================================= -->
<div class="sb-modal-backdrop" id="orderReviewModal" style="display: none;">
    <div class="sb-modal-box sb-review-modal-box">
        <div class="sb-modal-header">
            <div class="sb-modal-title-wrap">
                <button type="button" class="sb-pane-back" onclick="closeOrderReviewModal()">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                </button>
                <div>
                    <h4 style="margin:0; font-size: 17px; font-weight:800;">অর্ডার পর্যালোচনা</h4>
                    <small style="color: #64748b; font-weight: 600;">রহিম উদ্দিন</small>
                </div>
            </div>
            <button type="button" class="sb-modal-close-btn" onclick="closeOrderReviewModal()">&times;</button>
        </div>

        <div class="sb-modal-body">
            <h5 style="margin: 0 0 12px; font-size: 14px; font-weight: 700; color: #475569;">পণ্যগুলোর তালিকা</h5>

            <!-- Extracted Parsed Items List -->
            <div class="sb-parsed-items-list" id="parsedItemsList">
                <!-- Item 1: কাঁচামরিচ -->
                <div class="sb-parsed-item-card">
                    <div class="sb-item-thumb-box">
                        <img src="https://images.unsplash.com/photo-1588252303782-cb80119abd6d?w=100&q=80" alt="কাঁচামরিচ" />
                    </div>
                    <div class="sb-item-info">
                        <strong>কাঁচামরিচ</strong>
                        <small>পরিমাণ: ১</small>
                    </div>
                    <strong class="sb-item-price">৳ ২০</strong>
                    <button type="button" class="sb-btn-remove-item" onclick="removeParsedItem(this, 20)">×</button>
                </div>

                <!-- Item 2: হলুদ -->
                <div class="sb-parsed-item-card">
                    <div class="sb-item-thumb-box">
                        <img src="https://images.unsplash.com/photo-1615485290382-441e4d049cb5?w=100&q=80" alt="হলুদ" />
                    </div>
                    <div class="sb-item-info">
                        <strong>হলুদ</strong>
                        <small>পরিমাণ: ১</small>
                    </div>
                    <strong class="sb-item-price">৳ ১০</strong>
                    <button type="button" class="sb-btn-remove-item" onclick="removeParsedItem(this, 10)">×</button>
                </div>

                <!-- Item 3: লবণ -->
                <div class="sb-parsed-item-card">
                    <div class="sb-item-thumb-box">
                        <img src="https://images.unsplash.com/photo-1518110925495-5fe2fda0442c?w=100&q=80" alt="লবণ" />
                    </div>
                    <div class="sb-item-info">
                        <strong>লবণ</strong>
                        <small>পরিমাণ: ১</small>
                    </div>
                    <strong class="sb-item-price">৳ ১০</strong>
                    <button type="button" class="sb-btn-remove-item" onclick="removeParsedItem(this, 10)">×</button>
                </div>

                <!-- Item 4: শিম -->
                <div class="sb-parsed-item-card">
                    <div class="sb-item-thumb-box">
                        <img src="https://images.unsplash.com/photo-1567306226416-28f0efdc88ce?w=100&q=80" alt="শিম" />
                    </div>
                    <div class="sb-item-info">
                        <strong>শিম</strong>
                        <small>পরিমাণ: ১</small>
                    </div>
                    <strong class="sb-item-price">৳ ৫০</strong>
                    <button type="button" class="sb-btn-remove-item" onclick="removeParsedItem(this, 50)">×</button>
                </div>

                <!-- Item 5: আলু -->
                <div class="sb-parsed-item-card">
                    <div class="sb-item-thumb-box">
                        <img src="https://images.unsplash.com/photo-1518977676601-b53f82aba655?w=100&q=80" alt="আলু" />
                    </div>
                    <div class="sb-item-info">
                        <strong>আলু</strong>
                        <small>পরিমাণ: ১</small>
                    </div>
                    <strong class="sb-item-price">৳ ২০</strong>
                    <button type="button" class="sb-btn-remove-item" onclick="removeParsedItem(this, 20)">×</button>
                </div>
            </div>

            <!-- Review Summary Bar -->
            <div class="sb-review-total-bar">
                <div>
                    <span style="font-size: 11px; color: #64748b; display: block;">মোট পরিমাণ</span>
                    <strong id="reviewItemCount">৫ টি আইটেম</strong>
                </div>
                <div style="text-align: right;">
                    <span style="font-size: 11px; color: #64748b; display: block;">মোট টাকা</span>
                    <strong class="sb-text-green" id="reviewTotalAmount" style="font-size: 20px;">৳ ১১০</strong>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="sb-review-action-btns">
                <button type="button" class="sb-btn-edit-order" onclick="enableEditMode()">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                    <span>এডিট করুন</span>
                </button>
                <button type="button" class="sb-btn-confirm-order" onclick="confirmOrderAndShowInvoice()">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                    <span>কনফার্ম করুন</span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL 2: স্ক্রিন ৩ - বিল ও লাভের হিসাব (Invoice & 50/50 Profit Modal)      -->
<!-- ========================================================================= -->
<div class="sb-modal-backdrop" id="invoiceProfitModal" style="display: none;">
    <div class="sb-modal-box sb-invoice-modal-box">
        <div class="sb-modal-header">
            <div class="sb-modal-title-wrap">
                <button type="button" class="sb-pane-back" onclick="closeInvoiceProfitModal()">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                </button>
                <div>
                    <h4 style="margin:0; font-size: 17px; font-weight:800;">বিল ও লাভের হিসাব</h4>
                    <small style="color: #64748b; font-weight: 600;">রহিম উদ্দিন</small>
                </div>
            </div>
            <div style="display: flex; gap: 8px;">
                <button type="button" class="sb-btn-icon-top" onclick="window.print()" title="Print Bill">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
                </button>
                <button type="button" class="sb-btn-icon-top" onclick="downloadInvoicePdf()" title="PDF Download">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><polyline points="9 15 12 18 15 15"/></svg>
                </button>
                <button type="button" class="sb-modal-close-btn" onclick="closeInvoiceProfitModal()">&times;</button>
            </div>
        </div>

        <div class="sb-modal-body">
            <!-- Success Status Pill -->
            <div class="sb-invoice-success-pill">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                <span>অর্ডার সফলভাবে সম্পন্ন হয়েছে</span>
            </div>

            <!-- Bill Metadata -->
            <div class="sb-bill-metadata-card">
                <div class="sb-meta-row">
                    <span>বিল নম্বর</span>
                    <strong>#SB2505261050</strong>
                </div>
                <div class="sb-meta-row">
                    <span>তারিখ ও সময়</span>
                    <span>26 May 2025, 10:35 AM</span>
                </div>
                <div class="sb-meta-row">
                    <span>পেমেন্ট মেথড</span>
                    <strong>নগদ (Cash)</strong>
                </div>
            </div>

            <!-- Itemized Table -->
            <div class="sb-invoice-table-wrap">
                <span class="sb-tbl-caption">পণ্যের তালিকা</span>
                <table class="sb-invoice-table">
                    <thead>
                        <tr>
                            <th>পণ্য</th>
                            <th style="text-align: center;">দাম (৳)</th>
                            <th style="text-align: center;">পরিমাণ</th>
