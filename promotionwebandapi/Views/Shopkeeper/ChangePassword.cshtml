@model ShopkeeperDashboardViewModel
@{
    ViewData["Title"] = "Change Password";
    ViewData["ActivePage"] = "ChangePassword";
}

@section Styles {
    <style>
        .product-message {
            display: none;
            margin-top: 16px;
            padding: 12px 14px;
            border-radius: 10px;
            font-weight: 700;
        }

        .product-message.success {
            display: block;
            background: #dcfce7;
            color: #166534;
        }

        .product-message.error {
            display: block;
            background: #fee2e2;
            color: #991b1b;
        }
    </style>
}

<main class="app-page shop-theme shop-portal-page">
    <div class="shop-portal-shell">
        <partial name="_Sidebar" model="Model" />
        
        <section class="shop-page-content">
            <header class="shop-page-header">
                <div>
                    <span>SECURITY</span>
                    <h1>পাসওয়ার্ড পরিবর্তন</h1>
                    <p>আপনার অ্যাকাউন্টের নিরাপত্তা রক্ষা করতে পাসওয়ার্ড পরিবর্তন করুন।</p>
                </div>
            </header>
            
            <section class="panel">
                <h2>পাসওয়ার্ড পরিবর্তন করুন</h2>
                <p class="panel-copy" style="color: #64748b; margin-bottom: 20px;">নিচের ফর্মটি সঠিক তথ্য দিয়ে পূরণ করে পাসওয়ার্ড সংরক্ষণ করুন।</p>

                <form id="changePasswordForm" style="max-width: 500px;" data-managed-loading="true">
                    @Html.AntiForgeryToken()
                    
                    <div class="form-stack" style="display: grid; gap: 16px; margin-bottom: 20px;">
                        <div>
                            <label for="oldPassword" style="display: block; margin-bottom: 8px; font-weight: 800; color: #334155;">বর্তমান পাসওয়ার্ড *</label>
                            <input type="password" id="oldPassword" name="OldPassword" required style="width: 100%; min-height: 46px; padding: 10px 12px; border: 1px solid #cbd5e1; border-radius: 10px; font: inherit;" />
                        </div>
                        <div>
                            <label for="newPassword" style="display: block; margin-bottom: 8px; font-weight: 800; color: #334155;">নতুন পাসওয়ার্ড *</label>
                            <input type="password" id="newPassword" name="NewPassword" required style="width: 100%; min-height: 46px; padding: 10px 12px; border: 1px solid #cbd5e1; border-radius: 10px; font: inherit;" />
                        </div>
                        <div>
                            <label for="confirmPassword" style="display: block; margin-bottom: 8px; font-weight: 800; color: #334155;">নতুন পাসওয়ার্ড নিশ্চিত করুন *</label>
                            <input type="password" id="confirmPassword" name="ConfirmPassword" required style="width: 100%; min-height: 46px; padding: 10px 12px; border: 1px solid #cbd5e1; border-radius: 10px; font: inherit;" />
                        </div>
                    </div>

                    <button class="btn-primary" type="submit" style="min-width: 180px; min-height: 46px; border: 0; border-radius: 10px; background: #1464e9; color: #fff; font-weight: 800; cursor: pointer;">পাসওয়ার্ড সংরক্ষণ করুন</button>
                </form>

                <div id="pwMessage" class="product-message" role="alert"></div>
            </section>
        </section>
    </div>
</main>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script>
        $(function () {
            $('#changePasswordForm').on('submit', function (event) {
                event.preventDefault();

                const $form = $(this);
                const $button = $form.find('button[type="submit"]');
                const $message = $('#pwMessage');
                const token = $form.find('input[name="__RequestVerificationToken"]').val();

                const oldPassword = $('#oldPassword').val();
                const newPassword = $('#newPassword').val();
                const confirmPassword = $('#confirmPassword').val();

                if (newPassword.length < 4) {
                    $message.removeClass('success').addClass('error').text('পাসওয়ার্ড কমপক্ষে ৪ অক্ষরের হতে হবে।').show();
                    return;
                }

                if (newPassword !== confirmPassword) {
                    $message.removeClass('success').addClass('error').text('নতুন পাসওয়ার্ড এবং নিশ্চিতকরণ পাসওয়ার্ড মেলেনি।').show();
                    return;
                }

                const data = {
                    oldPassword: oldPassword,
                    newPassword: newPassword,
                    confirmPassword: confirmPassword
                };

                $message.removeClass('success error').hide();
                $button.prop('disabled', true).text('সংরক্ষণ হচ্ছে...');

                $.ajax({
                    url: '@Url.Action("ChangePassword", "Shopkeeper")',
                    method: 'POST',
                    contentType: 'application/json; charset=utf-8',
                    dataType: 'json',
                    headers: {
                        RequestVerificationToken: token
                    },
                    data: JSON.stringify(data)
                })
                .done(function (result) {
                    $message.removeClass('error').addClass('success').text(result.message || 'পাসওয়ার্ড সফলভাবে পরিবর্তন করা হয়েছে।').show();
                    $form[0].reset();
                })
                .fail(function (xhr) {
                    let message = 'পাসওয়ার্ড পরিবর্তন করা যায়নি। আবার চেষ্টা করুন।';
                    if (xhr.status === 401) {
                        message = 'আপনার session শেষ হয়েছে। আবার login করুন।';
                    } else if (xhr.responseJSON && xhr.responseJSON.message) {
                        message = xhr.responseJSON.message;
                    }
                    $message.removeClass('success').addClass('error').text(message).show();
                })
                .always(function () {
                    $button.prop('disabled', false).text('পাসওয়ার্ড সংরক্ষণ করুন');
                });
            });
        });
    </script>
}
